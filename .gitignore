# 超过 GitHub 100MB 单文件限制的原始压缩包
source/*.zip
source/*.rar

# 上游仓库克隆自带的 git 元数据
source/dummy/.git/

# 本地构建产物与日志
logs/

# Altium 自动备份与预览缓存（打开工程即自动生成）
History/
__Previews/
*.PrjPcbStructure
*.SchDocPreview
*.PcbDocPreview

# 失败的 gitee 克隆残留：只有 .git 骨架，零对象、无工作区文件
source/dummy2/

# SolidWorks / Office 临时锁文件（软件打开文档时自动生成，关闭后残留）
~$*

# 固件构建目录的中间产物（只保留 .elf/.hex/.bin/.map 四个产物本体）
source/1.Dummy V2任同学整理/2.Firmware/build/*/CMakeFiles/
source/1.Dummy V2任同学整理/2.Firmware/build/*/CMakeCache.txt
source/1.Dummy V2任同学整理/2.Firmware/build/*/cmake_install.cmake
source/1.Dummy V2任同学整理/2.Firmware/build/*/Makefile
