width": 1280, "height": 720, "vcodec": "hev1.1.6.L120.90", "acodec": "none", "dynamic_range": "SDR", "tbr": 226.533, "quality": 64, "format_id": "30066", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 226.533, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 18668188, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BMdzB1E57/"}}, {"url": "https://upos-sz-estgoss.bilivideo.com/upgcxcode/69/98/37576509869/37576509869-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&trid=a6be21c00ffd47faadab35fbc8e4410u&uipk=5&oi=664447097&nbs=1&os=estgoss&og=ali&deadline=1789987946&mid=3461562375342187&gen=playurlv3&platform=pc&upsig=d7d94ae430957feee9f011b8e1567cd0&uparams=e,trid,uipk,oi,nbs,os,og,deadline,mid,gen,platform&bvc=vod&nettype=0&bw=223545&lrs=-1&build=0&dl=0&f=u_0_0&qn_dyeid=126096023ff90d8500b95f9f6ab0f04a&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 223.423, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 223.423, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 18411898, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1BMdzB1E57/"}}], "duration": 659.266, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/37576509869.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,360 --> 00:00:02,440\n大家好\n\n2\n00:00:02,440 --> 00:00:07,850\n今天给大家带来基于STM32QVX和Q5\n\n3\n00:00:07,850 --> 00:00:12,230\n移植最新的free er TOS和LVGL的教程\n\n4\n00:00:12,230 --> 00:00:14,930\n全部操作都是手把手教学好了\n\n5\n00:00:14,930 --> 00:00:15,950\n我们废话不多说\n\n6\n00:00:15,950 --> 00:00:18,160\n直接先开始移植free RT is\n\n7\n00:00:18,160 --> 00:00:21,800\n首先我们来下载free i t o e s的源码\n\n8\n00:00:21,800 --> 00:00:24,810\n我们直接搜索这个free a TOS源码\n\n9\n00:00:24,810 --> 00:00:27,710\n就可以出现一个大大的官网\n\n10\n00:00:27,710 --> 00:00:30,170\n然后我们点进去\n\n11\n00:00:30,410 --> 00:00:32,630\n我们直接点击这一个分支\n\n12\n00:00:32,630 --> 00:00:36,450\nbriei TOS kernel这个分支\n\n13\n00:00:37,160 --> 00:00:40,720\n直接点这个download zip就可以下载了\n\n14\n00:00:40,720 --> 00:00:43,890\n如果你们download比较慢的话呢\n\n15\n00:00:43,890 --> 00:00:46,370\n也可以找国内的这个镜像园\n\n16\n00:00:46,370 --> 00:00:49,099\n这里也是官方的源码\n\n17\n00:00:49,099 --> 00:00:51,539\n只不过他可能不是很新\n\n18\n00:00:52,939 --> 00:00:54,459\n但是也是一样的\n\n19\n00:00:55,699 --> 00:00:57,299\nOk\n\n20\n00:01:00,160 --> 00:01:01,640\n下完源码之后\n\n21\n00:01:01,640 --> 00:01:05,400\n我们打开QVX创建一个工程\n\n22\n00:01:05,900 --> 00:01:11,780\n我用的芯片是STM三二F407vet六\n\n23\n00:01:12,020 --> 00:01:13,840\n大家芯片不一样\n\n24\n00:01:13,840 --> 00:01:16,740\n自己选自己的就可以了\n\n25\n00:01:17,740 --> 00:01:20,700\n这个教程是通用的\n\n26\n00:01:29,200 --> 00:01:33,000\n我们进来之后先根据自己的晶振配置\n\n27\n00:01:33,000 --> 00:01:34,320\n始终\n\n28\n00:01:36,380 --> 00:01:38,220\n这里把频率拉满\n\n29\n00:01:38,220 --> 00:01:40,700\n记得点一下回车\n\n30\n00:01:43,320 --> 00:01:46,840\n接下来我们选择调试接口\n\n31\n00:01:48,240 --> 00:01:49,860\n然后就是很重要的一步\n\n32\n00:01:49,860 --> 00:01:52,900\n把free toos的心跳和help库的时机分别\n\n33\n00:01:52,900 --> 00:01:56,440\nhelp库的时机用team6即可\n\n34\n00:01:57,100 --> 00:01:59,120\n这里我们打开串口\n\n35\n00:01:59,120 --> 00:02:01,020\n方便调试\n\n36\n00:02:06,880 --> 00:02:12,080\n勾选一些其他必要选项之后给项目命名\n\n37\n00:02:13,049 --> 00:02:14,629\n就叫project吧\n\n38\n00:02:14,629 --> 00:02:16,329\n生成代码\n\n39\n00:02:19,460 --> 00:02:20,580\n生成完了\n\n40\n00:02:20,580 --> 00:02:22,680\n我们先不着急打开\n\n41\n00:02:22,680 --> 00:02:25,300\n打开了也没关系\n\n42\n00:02:27,440 --> 00:02:30,380\n我们先把free rtos的源码\n\n43\n00:02:30,380 --> 00:02:34,240\n复制到我们工程目录下的文件夹\n\n44\n00:02:39,620 --> 00:02:41,260\n复制过来之后\n\n45\n00:02:41,260 --> 00:02:44,260\n我们要进行一些裁剪\n\n46\n00:02:46,020 --> 00:02:48,760\n保留example include portable\n\n47\n00:02:48,760 --> 00:02:51,920\n这三个文件夹以及DC文件\n\n48\n00:02:51,920 --> 00:02:54,750\n其他的全都不要了\n\n49\n00:03:01,440 --> 00:03:05,240\nOK裁剪完成之后就是这样的\n\n50\n00:03:07,360 --> 00:03:10,240\n接下来我们打开工程\n\n51\n00:03:11,800 --> 00:03:14,850\n进来之后我们点击小柜子\n\n52\n00:03:14,850 --> 00:03:17,910\n新增一个free i tao s分组\n\n53\n00:03:17,910 --> 00:03:21,730\n然后往里面加入我们必需的点C文件\n\n54\n00:03:21,730 --> 00:03:23,850\n一共九个\n\n55\n00:03:28,200 --> 00:03:32,620\nPO这里面加入的这个文件夹里的文件\n\n56\n00:03:32,620 --> 00:03:37,440\n和RVDS下的这个文件夹里的文件比较特殊\n\n57\n00:03:37,440 --> 00:03:40,570\n这两个文件取决于你用的芯片\n\n58\n00:03:40,570 --> 00:03:43,510\n我这里就选择了适配F4的\n\n59\n00:03:43,510 --> 00:03:49,290\n添加完之后不要忘了在魔术棒把路径添加进去\n\n60\n00:04:19,620 --> 00:04:23,900\n这里再把我们工程的文件夹路径添加进去\n\n61\n00:04:23,900 --> 00:04:27,740\n方便我们以后少添加文件路径\n\n62\n00:04:28,100 --> 00:04:31,280\n大家可以把这个选项取消勾选\n\n63\n00:04:31,280 --> 00:04:33,660\n加快编译速度\n\n64\n00:04:37,420 --> 00:04:38,560\n天降完了\n\n65\n00:04:38,560 --> 00:04:41,180\n我们直接编译看看\n\n66\n00:04:41,740 --> 00:04:43,640\n看到九个报错\n\n67\n00:04:43,640 --> 00:04:47,220\n说我们没有这个CONFIG文件\n\n68\n00:04:47,419 --> 00:04:51,919\n我们进入之前复制过来的free RT o e s文件夹\n\n69\n00:04:51,919 --> 00:04:55,099\n里面有一个example文件夹\n\n70\n00:04:55,320 --> 00:04:58,720\n点进去可以找到几个CONFIG文件\n\n71\n00:04:58,720 --> 00:05:01,080\n像这个比较大\n\n72\n00:05:01,580 --> 00:05:03,280\n这个就小一点\n\n73\n00:05:03,280 --> 00:05:07,100\n我们把这个小的复制到free rtos杠\n\n74\n00:05:07,100 --> 00:05:09,940\ninclude这个文件夹下\n\n75\n00:05:10,679 --> 00:05:13,279\n再回去编译看看\n\n76\n00:05:14,520 --> 00:05:16,700\n可以看到报错变了\n\n77\n00:05:16,700 --> 00:05:21,560\n这时候我们就来修改我们的这个CONFIG文件\n\n78\n00:05:22,810 --> 00:05:24,870\n为了方便编辑代码\n\n79\n00:05:24,870 --> 00:05:28,330\n我用vs code来编辑代码\n\n80\n00:05:30,120 --> 00:05:35,120\n这里我们找一下free RT o s config这个文件\n\n81\n00:05:40,460 --> 00:05:42,440\nOK啊重头戏来了\n\n82\n00:05:42,440 --> 00:05:44,909\n就是改这些配置\n\n83\n00:05:45,269 --> 00:05:49,550\n先改系统时钟频率成自己CPU的\n\n84\n00:05:49,670 --> 00:05:54,590\n然后把系统频率从10ms改成一毫秒\n\n85\n00:05:58,180 --> 00:06:01,260\n把这个空闲休眠关掉\n\n86\n00:06:02,560 --> 00:06:05,360\n点到任务名程度\n\n87\n00:06:07,680 --> 00:06:12,040\n把这个选项从64改成32\n\n88\n00:06:20,440 --> 00:06:24,840\n把我们的堆按照自身情况改大一点\n\n89\n00:06:32,240 --> 00:06:34,300\n把这个自定义分配关掉\n\n90\n00:06:34,300 --> 00:06:36,420\n让RTOS帮我们分配\n\n91\n00:06:36,420 --> 00:06:39,560\n接下来给中断优先级\n\n92\n00:06:43,560 --> 00:06:47,440\n这个最低的改成15就可以了\n\n93\n00:06:52,080 --> 00:06:55,320\n最高的我们改成五吧\n\n94\n00:06:59,980 --> 00:07:02,740\n下面这个也改成五\n\n95\n00:07:06,220 --> 00:07:08,100\n为了方便我们调试\n\n96\n00:07:08,100 --> 00:07:11,220\n把下面这两个选项也打开\n\n97\n00:07:13,070 --> 00:07:14,250\nOK改好了\n\n98\n00:07:14,250 --> 00:07:16,510\n我们去编译看看\n\n99\n00:07:17,890 --> 00:07:20,230\n可以看到已经没问题了\n\n100\n00:07:20,230 --> 00:07:24,850\n接下来我们打开F407的it中断文件\n\n101\n00:07:27,960 --> 00:07:31,020\n包含以下RTOS的头文件\n\n102\n00:07:31,020 --> 00:07:32,440\n注意顺序\n\n103\n00:07:32,440 --> 00:07:34,920\n不然会报错\n\n104\n00:07:43,840 --> 00:07:46,000\n然后找到SVC中断\n\n105\n00:07:47,000 --> 00:07:51,520\n把RTOS的同类型中段添加进去\n\n106\n00:08:01,900 --> 00:08:05,020\nPNDSV同理\n\n107\n00:08:08,800 --> 00:08:10,840\n最后添加心跳\n\n108\n00:08:10,840 --> 00:08:15,320\n记得在任务调度之前不要跑心跳\n\n109\n00:08:16,980 --> 00:08:19,780\n这里我们判断一下\n\n110\n00:08:22,460 --> 00:08:23,140\nOK呀\n\n111\n00:08:23,140 --> 00:08:24,820\n也是移植好了\n\n112\n00:08:24,820 --> 00:08:27,820\n那么我们怎么验证呢\n\n113\n00:08:29,840 --> 00:08:34,320\n这里博主给大家带来一个快速验证包\n\n114\n00:08:35,250 --> 00:08:39,770\n把里面的内容全部复制到工程文件夹\n\n115\n00:08:47,780 --> 00:08:52,520\n其中里面的app seat文件就是创建了一个任务\n\n116\n00:08:52,520 --> 00:08:56,090\n定时打印日志的这个功能\n\n117\n00:08:56,090 --> 00:08:58,630\n要把free RT o s configure\n\n118\n00:08:58,630 --> 00:09:01,680\n点H里的这两个选项打开\n\n119\n00:09:01,680 --> 00:09:08,080\napp main这个文件就是开启调度器初始化功能\n\n120\n00:09:10,180 --> 00:09:15,420\ndebug这个文件就是方便我们用串口输出日志\n\n121\n00:09:23,720 --> 00:09:27,920\n可以看到我们在这里创建了一个任务\n\n122\n00:09:29,180 --> 00:09:32,100\n这里是kitty调度器\n\n123\n00:09:35,800 --> 00:09:39,600\nOK我们直接打开main DC\n\n124\n00:09:41,780 --> 00:09:44,740\n调用刚刚的这个函数\n\n125\n00:09:47,220 --> 00:09:49,780\n包含以下头文件\n\n126\n00:09:53,340 --> 00:09:55,210\nOK回到Q5\n\n127\n00:09:55,210 --> 00:09:58,450\n添加一下刚刚的这几个文件\n\n128\n00:09:58,450 --> 00:09:59,950\n打开小柜子\n\n129\n00:09:59,950 --> 00:10:04,250\n创建app分组和SVS分组\n\n130\n00:10:08,760 --> 00:10:12,200\n把文件都对应添加进去\n\n131\n00:10:34,760 --> 00:10:36,760\n编译下载\n\n132\n00:10:42,900 --> 00:10:45,420\n打开tr口工具\n\n133\n00:10:46,160 --> 00:10:50,520\n可以看到log已经源源不断地冒出来了\n\n134\n00:10:54,160 --> 00:10:56,740\nfr TOS移植完美成功\n\n135\n00:10:56,740 --> 00:10:59,220\n接下来就是LVGL的移植\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1BMdzB1E57/", "webpage_url_basename": "BV1BMdzB1E57", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "thumbnails": [{"url": "http://i2.hdslb.com/bfs/archive/7fd13d34e277f2f69d8c443ca03dac3f463bd838.jpg", "id": "0"}], "display_id": "BV1BMdzB1E57_p1", "fulltitle": "手把手系列：在STM32上从零移植最新版本的FreeRTOS与LVGL p01 移植freertos", "duration_string": "10:59", "upload_date": "20260417", "epoch": 1789980751, "format": "720P 准高清+30216 - audio only", "format_id": "30064+30216", "ext": "mp4", "protocol": "https+https", "filesize_approx": 23823895, "tbr": 289.096, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 223.423, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "