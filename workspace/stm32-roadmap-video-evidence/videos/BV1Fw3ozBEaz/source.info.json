&f=u_0_0&gen=playurlv3&lrs=-1&mid=3461562375342187&nbs=1&nettype=0&og=hw&oi=664447097&orderid=0%2C3&os=08hbv&platform=pc&qn_dyeid=a5cb6ca8d431740f000a95576ab0ee30&sign=c73e04&traceid=trLBxRUTVNTMAS_0_e_N&uipk=5&uparams=e%2Cdeadline%2Coi%2Cuipk%2Cgen%2Cog%2Cplatform%2Cnbs%2Ctrid%2Cmid%2Cos&upsig=6e3b00467155f99682429bc347a9a45b", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "hev1.1.6.L120.90", "acodec": "none", "dynamic_range": "SDR", "tbr": 311.757, "quality": 64, "format_id": "30066", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 311.757, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 26481068, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1Fw3ozBEaz/"}}, {"url": "https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/36/09/30873750936/30873750936-1-100048.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&trid=8a25f4b84bb4465198f9ca0d177c367u&deadline=1789987408&gen=playurlv3&os=cosbv&og=cos&nbs=1&uipk=5&mid=3461562375342187&oi=664447097&platform=pc&upsig=e54b3fe1e0bbfdb58635a469b24e4e52&uparams=e,trid,deadline,gen,os,og,nbs,uipk,mid,oi,platform&bvc=vod&nettype=0&bw=447425&lrs=-1&f=u_0_0&qn_dyeid=a5cb6ca8d431740f000a95576ab0ee30&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640028", "acodec": "none", "dynamic_range": "SDR", "tbr": 447.065, "quality": 64, "format_id": "100048", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 447.065, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 37974315, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1Fw3ozBEaz/"}}], "duration": 679.531, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/30873750936.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,040 --> 00:00:00,560\n哈喽大家好\n\n2\n00:00:00,560 --> 00:00:05,110\n我是最近有很多同学呃问我如何自学嵌入式\n\n3\n00:00:05,110 --> 00:00:06,810\n今天我为大家分享一下\n\n4\n00:00:06,810 --> 00:00:09,490\n如何自学嵌入式的单片机\n\n5\n00:00:09,490 --> 00:00:11,400\n也就是MCU部分\n\n6\n00:00:11,400 --> 00:00:13,680\n然后再给大家推荐一些\n\n7\n00:00:13,680 --> 00:00:16,500\n我觉得比较好的视频和资源\n\n8\n00:00:16,500 --> 00:00:19,700\n让大家可以更快速的学习好\n\n9\n00:00:19,700 --> 00:00:23,100\n首先说几个想法\n\n10\n00:00:23,100 --> 00:00:26,640\n首先就是学习嵌入式开发\n\n11\n00:00:26,640 --> 00:00:29,160\n是需要花钱买一些硬件的\n\n12\n00:00:29,160 --> 00:00:31,400\n就例如一个蓝牙模块\n\n13\n00:00:31,400 --> 00:00:32,340\nWIFI模块\n\n14\n00:00:32,340 --> 00:00:34,000\n甚至一个电机驱动模块\n\n15\n00:00:34,000 --> 00:00:37,370\n他们都是要十几块钱或者20块钱\n\n16\n00:00:37,370 --> 00:00:41,310\n所以说前期的投入和花费是必须的\n\n17\n00:00:41,310 --> 00:00:42,170\n如果你不买\n\n18\n00:00:42,170 --> 00:00:43,999\n那就很难学到\n\n19\n00:00:43,999 --> 00:00:45,339\n当然如果你在学校里\n\n20\n00:00:45,339 --> 00:00:46,839\n你可以参加相关的社团\n\n21\n00:00:46,839 --> 00:00:48,630\n或者去找实验室老师\n\n22\n00:00:48,630 --> 00:00:52,220\n因为实验室里面一般都会有这些模块的储备\n\n23\n00:00:52,460 --> 00:00:54,340\n这也算是一个白嫖小技巧\n\n24\n00:00:54,340 --> 00:00:56,140\n第二个就是嵌入式学习\n\n25\n00:00:56,140 --> 00:00:58,070\n需要学习的东西比较多\n\n26\n00:00:58,070 --> 00:01:02,710\n然后要学习软件方面和硬件方面的知识\n\n27\n00:01:02,710 --> 00:01:04,590\n嗯当然初学者的话\n\n28\n00:01:04,590 --> 00:01:07,509\n只要先用起来了解一下就好了\n\n29\n00:01:07,509 --> 00:01:09,509\n当你之后再去深入\n\n30\n00:01:09,509 --> 00:01:12,310\n然后再去精通它们\n\n31\n00:01:12,470 --> 00:01:16,510\n不需要要求一开始就要学的非常透彻\n\n32\n00:01:16,510 --> 00:01:19,000\n因为这一般是不太可能的\n\n33\n00:01:19,000 --> 00:01:22,040\n第三如果你确定了你要自学\n\n34\n00:01:22,040 --> 00:01:25,150\n就我就建议你要一定要买一个开发版\n\n35\n00:01:25,150 --> 00:01:27,830\n由于嵌入式的学习需要反复的修改\n\n36\n00:01:27,830 --> 00:01:30,030\n测试和动手去实践\n\n37\n00:01:30,030 --> 00:01:32,350\n只看视频是肯定学不会的\n\n38\n00:01:32,350 --> 00:01:34,930\n如果你还是不太确定你自己要不要学\n\n39\n00:01:34,930 --> 00:01:36,910\n想前期不投入那么多\n\n40\n00:01:36,910 --> 00:01:39,949\n那我建议你去闲鱼买个二手的开发版\n\n41\n00:01:39,949 --> 00:01:43,129\n然后如果大不了再签约二手出掉\n\n42\n00:01:43,129 --> 00:01:46,810\n第四还有一些朋友问我要不要转行嵌入式\n\n43\n00:01:46,810 --> 00:01:50,120\n或者有一些大三的学生嗯\n\n44\n00:01:50,120 --> 00:01:50,860\n比较焦虑\n\n45\n00:01:50,860 --> 00:01:54,100\n因为他在学校里只学了C语言和学校一些教导\n\n46\n00:01:54,100 --> 00:01:56,680\n数电模电基础知识不是很多\n\n47\n00:01:56,680 --> 00:01:59,160\n那么该怎么办\n\n48\n00:01:59,160 --> 00:02:00,900\n嗯要不要学嵌入式\n\n49\n00:02:00,900 --> 00:02:03,560\n我要不要转嵌入式啊这些的\n\n50\n00:02:03,560 --> 00:02:06,280\n虽然我不是很想让你们来卷我们\n\n51\n00:02:06,280 --> 00:02:07,320\n但说实话\n\n52\n00:02:07,320 --> 00:02:11,970\n嵌入式对于学历的包容性还是很大的\n\n53\n00:02:11,970 --> 00:02:13,450\n假如你只是专科\n\n54\n00:02:13,450 --> 00:02:14,710\n但你只要能力强\n\n55\n00:02:14,710 --> 00:02:15,930\n你也是可以入行\n\n56\n00:02:15,930 --> 00:02:18,530\n并且拿到一个不错的薪资嗯\n\n57\n00:02:18,530 --> 00:02:19,850\n而且你的学历越高\n\n58\n00:02:19,850 --> 00:02:21,830\n你的上限也就越高\n\n59\n00:02:22,270 --> 00:02:24,570\n如果你没有一个很好的选择\n\n60\n00:02:24,570 --> 00:02:28,050\n学习一个技术是一个不错的选择\n\n61\n00:02:28,050 --> 00:02:31,160\n当然我不一定是指嵌入式\n\n62\n00:02:31,160 --> 00:02:34,280\n当然嵌入式的前景还是比较广阔的\n\n63\n00:02:34,280 --> 00:02:36,440\n它小到家电\n\n64\n00:02:36,440 --> 00:02:38,840\n大到各种控制设备\n\n65\n00:02:38,840 --> 00:02:40,600\n像智能家居\n\n66\n00:02:40,600 --> 00:02:42,540\n然后什么电动牙刷\n\n67\n00:02:42,540 --> 00:02:44,110\n耳机嗯\n\n68\n00:02:44,110 --> 00:02:45,510\n蜂巢柜这些的\n\n69\n00:02:45,510 --> 00:02:48,870\n都是我们身边充斥了很多的一些设备\n\n70\n00:02:48,870 --> 00:02:51,430\n都是需要嵌入式来开发的\n\n71\n00:02:51,430 --> 00:02:53,510\n所以说他的就业方向比较广\n\n72\n00:02:53,510 --> 00:02:56,670\n虽然他的薪资相对于互联网那些大厂的\n\n73\n00:02:56,670 --> 00:02:57,890\n薪资没有他们高\n\n74\n00:02:57,890 --> 00:03:00,720\n但是他的对学历的门槛要求也不是很高\n\n75\n00:03:00,720 --> 00:03:04,020\n当然它的前提是你有一个扎实的技术\n\n76\n00:03:04,020 --> 00:03:05,960\n接下来就是给大家分享一下\n\n77\n00:03:05,960 --> 00:03:08,820\n如何系统性的学习单片机开发\n\n78\n00:03:08,820 --> 00:03:12,890\n首先你需要简单的学习一下C语言基础\n\n79\n00:03:12,890 --> 00:03:16,650\n这边我推荐浙江大学翁凯的C语言\n\n80\n00:03:16,650 --> 00:03:19,930\n对初学的话学到指针基本上就够用了\n\n81\n00:03:19,930 --> 00:03:23,730\n然后就可以进入到单片机程序的开发\n\n82\n00:03:23,730 --> 00:03:25,730\n当你学完C语言基础之后\n\n83\n00:03:25,730 --> 00:03:28,759\n你就可以考虑买一个开发版嗯\n\n84\n00:03:28,759 --> 00:03:31,259\n买开发版的好处是它有配套的教程\n\n85\n00:03:31,259 --> 00:03:32,980\n可以系统性的学习\n\n86\n00:03:32,980 --> 00:03:33,980\n各种模块\n\n87\n00:03:33,980 --> 00:03:35,940\n已经给你做到它的开发板上了\n\n88\n00:03:35,940 --> 00:03:39,940\n你不需要太关注于硬硬件的连接和硬件的调试\n\n89\n00:03:39,940 --> 00:03:42,120\n这这对初学者是很有帮助的\n\n90\n00:03:42,120 --> 00:03:43,660\n如果你才刚刚上大学\n\n91\n00:03:43,660 --> 00:03:45,560\n大一或者还没有上大学的话\n\n92\n00:03:45,560 --> 00:03:48,540\n我建议你是从ARDUINO开始学起\n\n93\n00:03:48,540 --> 00:03:50,880\n就因为它的上手会比较简单\n\n94\n00:03:50,880 --> 00:03:52,660\n你你只需要买一个开发版\n\n95\n00:03:52,660 --> 00:03:55,100\n然后买一些相关的拓展模块\n\n96\n00:03:55,100 --> 00:03:56,740\n它有封装的库\n\n97\n00:03:56,740 --> 00:03:59,380\n然后你直接调用十几行代码\n\n98\n00:03:59,380 --> 00:04:02,130\n就可以实现一个比较复杂的功能\n\n99\n00:04:02,130 --> 00:04:04,750\n一些模块的底层驱动你是不需要写的\n\n100\n00:04:04,750 --> 00:04:05,930\n别人已经帮你写好了\n\n101\n00:04:05,930 --> 00:04:07,610\n你只需要去调用就好了\n\n102\n00:04:07,610 --> 00:04:09,870\n如果你是大一到大二\n\n103\n00:04:09,870 --> 00:04:13,400\n那我建议你从五一就开始学\n\n104\n00:04:13,400 --> 00:04:16,040\n因为这样你可以了解一下\n\n105\n00:04:16,040 --> 00:04:18,699\n寄存器和比较底层的东西\n\n106\n00:04:18,699 --> 00:04:21,619\n这样对你以后的学习成长是很有帮助的\n\n107\n00:04:21,619 --> 00:04:26,240\n如果你大三或者已经毕业了呃\n\n108\n00:04:26,240 --> 00:04:27,480\n想要去学习的话\n\n109\n00:04:27,480 --> 00:04:29,900\n我建议你直接从STM32开始学起\n\n110\n00:04:29,900 --> 00:04:34,270\n因为STM32更偏向就业和实际的使用\n\n111\n00:04:34,270 --> 00:04:36,210\n而且使用还比较广泛\n\n112\n00:04:36,210 --> 00:04:38,070\n并且学习资料也比较多\n\n113\n00:04:38,070 --> 00:04:42,030\nSTM32的学习可以直接从号库呃学起\n\n114\n00:04:42,030 --> 00:04:47,370\n自T公司有对应的cool max可以直接生成嗯\n\n115\n00:04:47,370 --> 00:04:48,930\n上手会比较简单\n\n116\n00:04:48,930 --> 00:04:52,930\n当你把你的开发版的整个视频教程看完\n\n117\n00:04:52,930 --> 00:04:53,730\n学会了之后\n\n118\n00:04:53,730 --> 00:04:56,310\n那么我相信你已经学会了点灯按键\n\n119\n00:04:56,310 --> 00:04:57,940\n中断串口定时器\n\n120\n00:04:57,940 --> 00:05:01,060\nADCPWMI方CEFSPI\n\n121\n00:05:01,060 --> 00:05:04,510\n各种协议应该都了解和看了一遍\n\n122\n00:05:04,510 --> 00:05:09,110\n那你应该也会简单的看原理图和一些元器件\n\n123\n00:05:09,110 --> 00:05:09,550\n之后\n\n124\n00:05:09,550 --> 00:05:12,770\n你就可以尝试的去复刻一些项目\n\n125\n00:05:12,770 --> 00:05:15,590\n找一些项目可以去立创开源广场\n\n126\n00:05:15,590 --> 00:05:19,510\n这上面会有很多的开源项目\n\n127\n00:05:19,510 --> 00:05:22,410\n硬件结构和软件的实现\n\n128\n00:05:22,410 --> 00:05:23,750\n大部分都是会有的\n\n129\n00:05:23,750 --> 00:05:26,560\n然后我们可以看上面有五一单片机\n\n130\n00:05:26,560 --> 00:05:29,280\nTSSTM单片机\n\n131\n00:05:29,280 --> 00:05:30,480\n还有esp\n\n132\n00:05:30,480 --> 00:05:34,810\n8266esp32什么audio o这些都是有的\n\n133\n00:05:34,810 --> 00:05:37,430\n大家可以根据需求去选择\n\n134\n00:05:37,430 --> 00:05:39,719\n然后去复刻啊\n\n135\n00:05:39,719 --> 00:05:40,699\n在复课的过程中\n\n136\n00:05:40,699 --> 00:05:44,979\n有什么不会的问题都可以去查找\n\n137\n00:05:44,979 --> 00:05:48,210\n然后去学习嗯\n\n138\n00:05:48,210 --> 00:05:50,700\n当你复刻了一到两个项目之后\n\n139\n00:05:50,700 --> 00:05:53,760\n那么我觉得你就可以去学习一下RTOS\n\n140\n00:05:53,760 --> 00:05:55,000\n这些操作系统\n\n141\n00:05:55,000 --> 00:05:57,580\n学习RTS相对于裸机开发\n\n142\n00:05:57,580 --> 00:06:01,880\n会让你更加注重于逻辑功能的开发\n\n143\n00:06:01,880 --> 00:06:05,950\n当特别是涉及到多个模块相互使用\n\n144\n00:06:05,950 --> 00:06:06,830\n这样上\n\n145\n00:06:06,830 --> 00:06:10,970\nRTOS会让你的逻辑功能实现变得简单许多\n\n146\n00:06:10,970 --> 00:06:12,550\n当你复刻了几个项目\n\n147\n00:06:12,550 --> 00:06:14,360\nRTOS也学了之后\n\n148\n00:06:14,360 --> 00:06:16,300\n你肯定也就跃跃欲试\n\n149\n00:06:16,300 --> 00:06:18,220\n想要去自己做项目了\n\n150\n00:06:18,220 --> 00:06:20,000\n你在做项目的过程中\n\n151\n00:06:20,000 --> 00:06:22,400\n肯定会遇到一些硬件方面的问题\n\n152\n00:06:22,400 --> 00:06:23,920\n那么你这就这时候\n\n153\n00:06:23,920 --> 00:06:26,160\n你就需要补充一些电子系的基础\n\n154\n00:06:26,160 --> 00:06:28,560\n例如电阻电容二极管\n\n155\n00:06:28,560 --> 00:06:30,570\n三极管这些它是怎么用呢\n\n156\n00:06:30,570 --> 00:06:32,590\n它是什么功能啊\n\n157\n00:06:32,590 --> 00:06:35,570\n那么你就需要系统的去学习一下了\n\n158\n00:06:35,570 --> 00:06:39,240\n你在B站上搜一下度洋电子工作室啊\n\n159\n00:06:39,240 --> 00:06:41,760\n他现在已经改名叫杨桃电子了\n\n160\n00:06:41,760 --> 00:06:43,680\n大家搜这个名义当然也可以搜到\n\n161\n00:06:43,680 --> 00:06:49,140\n然后他就讲了很多例如电子技术方面的知识\n\n162\n00:06:49,140 --> 00:06:50,500\n还有一些各种元器件的\n\n163\n00:06:50,500 --> 00:06:51,940\n是各种元器件\n\n164\n00:06:51,940 --> 00:06:55,190\n然后还有一些面包板的制作\n\n165\n00:06:55,190 --> 00:06:58,830\n甚至还有一嗯密码制作工具的使用\n\n166\n00:06:58,830 --> 00:07:00,630\n像电烙铁啊这些的使用\n\n167\n00:07:00,630 --> 00:07:02,120\n大家都可以去搜一下\n\n168\n00:07:02,120 --> 00:07:04,380\n当然还有一些电子技术的学习顺序\n\n169\n00:07:04,380 --> 00:07:06,640\n我很建议大家去看一下\n\n170\n00:07:06,640 --> 00:07:08,500\n当你把这些都学完之后\n\n171\n00:07:08,500 --> 00:07:11,840\n那你肯定也需要学习一下a AD了吧\n\n172\n00:07:11,840 --> 00:07:12,820\n就是画一个板子\n\n173\n00:07:12,820 --> 00:07:14,440\n当然你不一定学习AD\n\n174\n00:07:14,440 --> 00:07:17,620\n你也可以使使用立创EDA呃\n\n175\n00:07:17,620 --> 00:07:20,260\n立创EDA的话上手会比较简单\n\n176\n00:07:20,260 --> 00:07:24,210\n并且硬件的话使用立创EEDA可以免费打样\n\n177\n00:07:24,210 --> 00:07:26,150\n直接免费白嫖电路板\n\n178\n00:07:26,150 --> 00:07:28,690\n这是一个低成本的学习学习方案\n\n179\n00:07:28,690 --> 00:07:29,820\n挺好的\n\n180\n00:07:29,820 --> 00:07:34,360\n杨桃电子还出了一些如何读懂数据手册\n\n181\n00:07:34,360 --> 00:07:36,289\n这一点也是非常重要的\n\n182\n00:07:36,289 --> 00:07:37,449\n然后当你有需要了\n\n183\n00:07:37,449 --> 00:07:38,549\n你可以来看一下\n\n184\n00:07:38,549 --> 00:07:40,069\n就把它作为一个字典\n\n185\n00:07:40,069 --> 00:07:43,079\n然后杨桃电子还有很多的视频\n\n186\n00:07:43,079 --> 00:07:45,019\n例如五幺各种元器件的识别\n\n187\n00:07:45,019 --> 00:07:46,630\n还有一些原理图\n\n188\n00:07:46,630 --> 00:07:48,390\n这些系统性的教程\n\n189\n00:07:48,390 --> 00:07:49,830\n我也非常推荐给大家\n\n190\n00:07:49,830 --> 00:07:52,750\n因为这样可以让大家系统性的学习知识\n\n191\n00:07:52,750 --> 00:07:55,280\n当你在复刻项目的过程中\n\n192\n00:07:55,280 --> 00:07:58,900\n你肯定会学到那debug调试万用表\n\n193\n00:07:58,900 --> 00:08:01,630\n测量硬件电路嗯\n\n194\n00:08:01,630 --> 00:08:04,770\n或者是使用逻辑分析仪嗯\n\n195\n00:08:04,770 --> 00:08:05,820\n抓取波形\n\n196\n00:08:05,820 --> 00:08:08,000\n这些都非常的简单\n\n197\n00:08:08,000 --> 00:08:09,500\n你如如果不会用\n\n198\n00:08:09,500 --> 00:08:12,000\n那你直接去网上搜索对应的关键词\n\n199\n00:08:12,000 --> 00:08:13,720\n单独去学习即可\n\n200\n00:08:13,720 --> 00:08:16,080\n不要担心自己好像没用过\n\n201\n00:08:16,080 --> 00:08:17,480\n其实他们都不难\n\n202\n00:08:17,480 --> 00:08:18,880\n它只是一个工具\n\n203\n00:08:18,880 --> 00:08:20,680\n当你把这些都学会了之后\n\n204\n00:08:20,680 --> 00:08:24,700\n我相信你已经是一个合格的嵌入式工程师了\n\n205\n00:08:24,700 --> 00:08:29,610\n可能你的在工作中或者去实现一些需求的时候\n\n206\n00:08:29,610 --> 00:08:32,630\n发现有些方面知识自己并没有涉及到\n\n207\n00:08:32,630 --> 00:08:33,870\n那么不必担心\n\n208\n00:08:33,870 --> 00:08:37,489\n你只要去网上搜对应的资料去学习就好了\n\n209\n00:08:37,489 --> 00:08:39,489\n其实我们在这个学习的过程中\n\n210\n00:08:39,489 --> 00:08:40,749\n不仅学习了知识\n\n211\n00:08:40,749 --> 00:08:43,679\n还有一方面要学习自己的自学能力\n\n212\n00:08:43,679 --> 00:08:45,460\n这一点也非常关键的\n\n213\n00:08:45,460 --> 00:08:47,680\n因为我们不可能把市面上的所有芯片\n\n214\n00:08:47,680 --> 00:08:49,940\n电路程序都用过一遍都写过\n\n215\n00:08:49,940 --> 00:08:51,490\n然后这就是技能\n\n216\n00:08:51,490 --> 00:08:54,210\n其次就是一些认知和观念\n\n217\n00:08:54,210 --> 00:08:56,930\n然后我前段时间也看到了呃\n\n218\n00:08:56,930 --> 00:09:00,230\n杜洋工作室出来的一个呃度洋观点\n\n219\n00:09:00,230 --> 00:09:02,569\n然后就是一些思考类的视频\n\n220\n00:09:02,569 --> 00:09:06,520\n这个视频的合集我很建议大家也去看一下\n\n221\n00:09:06,520 --> 00:09:11,920\n就是他讲到一些我们技术和钱的关系\n\n222\n00:09:11,920 --> 00:09:15,000\n还有呃如学习观念\n\n223\n00:09:15,000 --> 00:09:17,520\n我们要不停的去打破自己嗯\n\n224\n00:09:17,520 --> 00:09:20,670\n还有一些电子技术的学习顺序\n\n225\n00:09:20,670 --> 00:09:22,730\n我觉得这些视频对大家有一些启发\n\n226\n00:09:22,730 --> 00:09:23,810\n然后第四\n\n227\n00:09:23,810 --> 00:09:27,150\n接下来就推荐一些我觉得比较好的博主吧\n\n228\n00:09:27,150 --> 00:09:29,200\n就B站上有一个硬汉嵌入式\n\n229\n00:09:29,200 --> 00:09:32,640\n他会每一周会发一个嵌入式周报\n\n230\n00:09:32,640 --> 00:09:33,880\n给大家分享一下\n\n231\n00:09:33,880 --> 00:09:37,990\n嵌入式有哪些新鲜的产品或者项目\n\n232\n00:09:37,990 --> 00:09:39,170\n也有一些开源的\n\n233\n00:09:39,170 --> 00:09:43,409\n可以让大家了解一下嵌入式最新的一些近况\n\n234\n00:09:43,409 --> 00:09:46,349\n然后硬件方面我也再推荐两个博主\n\n235\n00:09:46,349 --> 00:09:49,030\n首先就是唐老师讲电赛\n\n236\n00:09:49,270 --> 00:09:51,350\n他讲的开关电源部分\n\n237\n00:09:51,350 --> 00:09:54,910\n还有运放是都是比较好的\n\n238\n00:09:54,910 --> 00:09:57,700\n会从原理图芯片\n\n239\n00:09:57,700 --> 00:10:00,560\n还有layout深刻的给大家剖析\n\n240\n00:10:01,600 --> 00:10:05,110\n学习硬件的朋友可以呃学习一下电源的设计\n\n241\n00:10:05,110 --> 00:10:06,110\n还有一些运放\n\n242\n00:10:06,110 --> 00:10:09,200\n另外一个博主叫gt硬件乐趣\n\n243\n00:10:09,200 --> 00:10:11,400\n这个博主是清华大学的毕业的\n\n244\n00:10:11,400 --> 00:10:12,440\n也非常的厉害\n\n245\n00:10:12,440 --> 00:10:15,260\n他会讲一些硬件方面的知识\n\n246\n00:10:15,260 --> 00:10:17,079\n通过理论分析\n\n247\n00:10:17,079 --> 00:10:19,039\n还有一些看似我们觉得简单\n\n248\n00:10:19,039 --> 00:10:20,699\n但没有深究的东西\n\n249\n00:10:20,699 --> 00:10:22,199\n他都会很理论\n\n250\n00:10:22,199 --> 00:10:24,040\n很细致的告诉我们\n\n251\n00:10:24,040 --> 00:10:27,819\n会让你非常深入地了解某一方面的知识\n\n252\n00:10:28,139 --> 00:10:30,839\n最终我觉得前期嵌入式的学习\n\n253\n00:10:30,839 --> 00:10:33,919\n是需要我们用兴趣去驱动的\n\n254\n00:10:33,919 --> 00:10:36,259\n比如我们点一下l led灯\n\n255\n00:10:36,259 --> 00:10:37,759\n用串口再发送\n\n256\n00:10:37,759 --> 00:10:39,359\n点一个led灯\n\n257\n00:10:39,359 --> 00:10:40,599\n我们驱动了屏幕\n\n258\n00:10:40,599 --> 00:10:42,319\n可以在屏幕上显示一下\n\n259\n00:10:42,319 --> 00:10:44,200\n我们想要显示的内容\n\n260\n00:10:44,200 --> 00:10:47,300\n这些可以跟我们的兴趣相结合\n\n261\n00:10:47,300 --> 00:10:50,150\n让我们的学习不那么的枯燥\n\n262\n00:10:50,390 --> 00:10:52,030\n后面复刻项目的时候\n\n263\n00:10:52,030 --> 00:10:54,990\n我们可以根据自己的兴趣去复刻\n\n264\n00:10:54,990 --> 00:10:57,470\n这样就也不会那么的枯燥\n\n265\n00:10:57,670 --> 00:10:59,310\n假如你是在学校之中\n\n266\n00:10:59,310 --> 00:11:01,870\n我觉得复课这些项目还是挺有趣的\n\n267\n00:11:01,870 --> 00:11:05,160\n并且他在你毕业之后去找工作\n\n268\n00:11:05,160 --> 00:11:06,440\n写在简历上\n\n269\n00:11:06,440 --> 00:11:07,820\n面试官也会觉得啊\n\n270\n00:11:07,820 --> 00:11:09,780\n这个人确实是比较热爱电子\n\n271\n00:11:09,780 --> 00:11:12,260\n有一定的理论和实践基础\n\n272\n00:11:12,260 --> 00:11:15,840\n这样就相对来说会比较好的找到工作\n\n273\n00:11:15,840 --> 00:11:18,100\n希望我的分享可以帮助到大家好\n\n274\n00:11:18,100 --> 00:11:19,500\n我们下期节目再见\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1Fw3ozBEaz/", "webpage_url_basename": "BV1Fw3ozBEaz", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "thumbnails": [{"url": "http://i0.hdslb.com/bfs/archive/2b07897033ea94e1c81d0824445f0a58a6b4e0cd.jpg", "id": "0"}], "display_id": "BV1Fw3ozBEaz", "fulltitle": "嵌入式如何自学", "duration_string": "11:19", "upload_date": "20250705", "epoch": 1789980212, "format": "720P 准高清+30280 - audio only", "format_id": "100048+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 46093351, "tbr": 542.649, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640028", "vbr": 447.065, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 95.584, "_type": "video", "_version": {"version": "2026.08.30.232658", "release_git_head": "bbc809a1161d3bfca51fa36f59dda35556ee85a0", "repository": "yt-dlp/yt-dlp-nightly-builds"}}