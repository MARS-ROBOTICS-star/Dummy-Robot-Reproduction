cbc0d70e33ab6f35bc0437&uparams=e,trid,nbs,deadline,gen,og,platform,oi,mid,uipk,os&bvc=vod&nettype=0&bw=140163&lrs=-1&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&f=u_0_0&qn_dyeid=ab01fccfe97079fb00837b966ab0ee88&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 718, "vcodec": "av01.0.00M.10.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 140.07, "quality": 64, "format_id": "100024", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 140.07, "resolution": "1280x718", "aspect_ratio": 1.78, "filesize_approx": 27379710, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1kun3zBEu1/"}}, {"url": "https://upos-sz-mirrorcoso1.bilivideo.com/upgcxcode/56/59/32647545956/32647545956-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&uipk=5&os=coso1bv&og=cos&mid=3461562375342187&deadline=1789987496&gen=playurlv3&platform=pc&trid=626c362a3df54baf9f4e2e2304d6b4fu&oi=664447097&nbs=1&upsig=ed12b47a3dc767b7a3a3b31b7c39adf0&uparams=e,uipk,os,og,mid,deadline,gen,platform,trid,oi,nbs&bvc=vod&nettype=0&bw=269953&lrs=-1&dl=0&f=u_0_0&qn_dyeid=ab01fccfe97079fb00837b966ab0ee88&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 718, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 269.796, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 269.796, "resolution": "1280x718", "aspect_ratio": 1.78, "filesize_approx": 52737462, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1kun3zBEu1/"}}], "duration": 1563.773, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/32647545956.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,020 --> 00:00:00,660\n大家好\n\n2\n00:00:00,660 --> 00:00:03,100\n今天向大家介绍如何优雅的开始\n\n3\n00:00:03,100 --> 00:00:05,449\n我们第一个嵌入式开发的项目\n\n4\n00:00:05,449 --> 00:00:09,289\n使用STM32单片机点亮led灯\n\n5\n00:00:09,289 --> 00:00:13,840\n那么首先打开我们的kill five开发软件啥\n\n6\n00:00:14,800 --> 00:00:17,480\n如果你是第一次打开这个软件的话\n\n7\n00:00:17,480 --> 00:00:20,130\n它的界面就会像现在这样一片空白\n\n8\n00:00:20,130 --> 00:00:23,730\n那么首先我们需要做的就是创建一个新的项目\n\n9\n00:00:23,730 --> 00:00:25,490\n找到上方的project\n\n10\n00:00:25,490 --> 00:00:27,330\n然后点击new project\n\n11\n00:00:27,330 --> 00:00:29,050\n创建项目\n\n12\n00:00:31,629 --> 00:00:33,529\n在弹出的窗口中\n\n13\n00:00:33,529 --> 00:00:36,829\n为项目选择一个合适的保存地址\n\n14\n00:00:36,829 --> 00:00:40,620\n那么在这里我把它直接保存在了桌面的位置\n\n15\n00:00:40,620 --> 00:00:42,660\n然后给这个项目命名\n\n16\n00:00:42,660 --> 00:00:44,700\n我这里给它命名为new吧\n\n17\n00:00:44,700 --> 00:00:46,180\n新项目\n\n18\n00:00:47,160 --> 00:00:51,690\n接下来需要选择开发使用的单片机的型号\n\n19\n00:00:51,690 --> 00:00:56,030\n那么在这里我使用的型号是SSTM32F\n\n20\n00:00:56,030 --> 00:00:57,610\n103C8T六\n\n21\n00:00:57,610 --> 00:00:59,040\n这个型号\n\n22\n00:00:59,360 --> 00:01:02,940\n我们可以在列表中快速的找到这个型号\n\n23\n00:01:02,940 --> 00:01:05,040\n并且选择它\n\n24\n00:01:09,180 --> 00:01:11,160\n那么这个神秘小代码\n\n25\n00:01:11,160 --> 00:01:13,120\n它的具体含义到底是什么呢\n\n26\n00:01:13,120 --> 00:01:15,560\n我们这里简单介绍一下\n\n27\n00:01:15,920 --> 00:01:18,820\n那么首先是STM32\n\n28\n00:01:18,820 --> 00:01:20,200\n他的意思是\n\n29\n00:01:20,200 --> 00:01:24,240\n这是一款由s st公司推出的32位微控制器\n\n30\n00:01:24,240 --> 00:01:28,460\nF是一个系列的编号103\n\n31\n00:01:28,460 --> 00:01:31,140\n这个编号则包含了这个单片机的内核\n\n32\n00:01:31,140 --> 00:01:32,600\n架构和性能\n\n33\n00:01:32,600 --> 00:01:37,360\n锡纸的是它这个芯片包含的引脚的数量\n\n34\n00:01:37,740 --> 00:01:41,360\n八则表示的是这个芯片内置的闪存容量\n\n35\n00:01:41,360 --> 00:01:45,550\n这款单片机是目前市面上应用较为广泛的\n\n36\n00:01:45,550 --> 00:01:48,470\n并且一些教学课程也会推荐\n\n37\n00:01:48,470 --> 00:01:50,350\n第一次试着开发的学生\n\n38\n00:01:50,350 --> 00:01:53,360\n使用这个类型的单片机进行开发\n\n39\n00:01:53,360 --> 00:01:55,360\n那么介绍完之后\n\n40\n00:01:55,360 --> 00:01:58,120\n我们再次回到我们的开发界面\n\n41\n00:01:58,120 --> 00:02:00,500\n点击OK\n\n42\n00:02:00,940 --> 00:02:04,040\n接下来就来到了我们manager runner的界面\n\n43\n00:02:04,040 --> 00:02:04,980\n在这个界面\n\n44\n00:02:04,980 --> 00:02:08,789\n我们主要是为了我们新的项目添加并配置\n\n45\n00:02:08,789 --> 00:02:10,680\n需要的祖茜\n\n46\n00:02:11,000 --> 00:02:13,520\n那么如果需要使用我们的开发板\n\n47\n00:02:13,520 --> 00:02:15,400\n点亮我们的led灯\n\n48\n00:02:15,400 --> 00:02:18,080\n也就是一个最最最基础的项目\n\n49\n00:02:18,080 --> 00:02:22,440\n有哪些最最最基础的组件需要被添加并配置呢\n\n50\n00:02:22,440 --> 00:02:27,480\n首先是这个点开这个CMS i is这个选项\n\n51\n00:02:27,480 --> 00:02:31,230\n找到我们的corn主体这个东西\n\n52\n00:02:31,230 --> 00:02:34,090\n这个CMSIS里面的QUE库\n\n53\n00:02:34,090 --> 00:02:35,650\n是我们必要选择的\n\n54\n00:02:35,650 --> 00:02:39,750\n接下来是device里面的startup嗯\n\n55\n00:02:39,750 --> 00:02:42,810\n这个system start up也是我们必选的一个选项\n\n56\n00:02:43,850 --> 00:02:46,450\n接下来是我们的这个\n\n57\n00:02:49,280 --> 00:02:53,180\ndevice里面的std praff\n\n58\n00:02:53,180 --> 00:02:56,340\n这个选项在这里面我们可以找到\n\n59\n00:02:56,340 --> 00:02:58,540\n首先我们可以找到这个RCCRCC\n\n60\n00:02:58,540 --> 00:03:00,840\n其实就是我们呃KALIFIES里面\n\n61\n00:03:00,840 --> 00:03:03,890\nGRSTM32单片机里面的一个呃\n\n62\n00:03:03,890 --> 00:03:05,610\n时钟这样的一个东西\n\n63\n00:03:05,610 --> 00:03:08,170\n看到we set and clock control\n\n64\n00:03:08,170 --> 00:03:09,490\n大家可能会觉得疑惑\n\n65\n00:03:09,490 --> 00:03:13,609\n说哎我们这个要点亮点亮这个小灯泡\n\n66\n00:03:13,609 --> 00:03:14,529\n为什么会需要钟\n\n67\n00:03:14,529 --> 00:03:17,029\n为什么会需要时间这样个东西嗯\n\n68\n00:03:17,029 --> 00:03:20,569\n反正在我的理解里面来STM32里面的clock\n\n69\n00:03:20,569 --> 00:03:23,760\n它它可以理解为是一种开关\n\n70\n00:03:23,760 --> 00:03:27,260\n所以说我们在这里选择的是一种开关的控制器\n\n71\n00:03:27,260 --> 00:03:30,300\n接着是这个GPRIOGPIO什么东西\n\n72\n00:03:30,300 --> 00:03:33,620\nGPRIO其实是我们的输出和输入端口\n\n73\n00:03:33,820 --> 00:03:37,160\n那么对于我们想要输出高电平或者低电平的话\n\n74\n00:03:37,160 --> 00:03:37,540\n呃\n\n75\n00:03:37,540 --> 00:03:39,790\n这个GPIO肯定也是非常必要的\n\n76\n00:03:40,370 --> 00:03:41,990\n所以把这四个都选上之后\n\n77\n00:03:41,990 --> 00:03:42,710\n我们就可以选择\n\n78\n00:03:42,710 --> 00:03:45,910\nOKOK之后我们的这个库就已经建立完毕了\n\n79\n00:03:45,910 --> 00:03:47,210\n可以看到在这个库里面\n\n80\n00:03:47,210 --> 00:03:51,310\n我们有比较完备的CMSISDEVS的一些设置\n\n81\n00:03:51,310 --> 00:03:52,630\n那么到了这里\n\n82\n00:03:52,630 --> 00:03:53,990\n想必大家一定认为\n\n83\n00:03:53,990 --> 00:03:57,330\n我们终于可以酣畅淋漓的开始写代码了\n\n84\n00:03:57,330 --> 00:03:59,130\n但是错已天真了\n\n85\n00:03:59,130 --> 00:03:59,770\n可以看到\n\n86\n00:03:59,770 --> 00:04:03,240\n当前界面还没有任何我们可以写代码的地方\n\n87\n00:04:03,240 --> 00:04:04,700\n那么应该怎么办呢\n\n88\n00:04:04,700 --> 00:04:09,519\n首先我们在软件中创建一个空白的文件\n\n89\n00:04:09,519 --> 00:04:12,379\n点击上方的file创建文件\n\n90\n00:04:12,379 --> 00:04:14,119\n这个文件呢它没有名字\n\n91\n00:04:14,119 --> 00:04:15,600\n也没有后缀名\n\n92\n00:04:15,600 --> 00:04:19,180\n我们需要先把它保存在我们的电脑中\n\n93\n00:04:19,180 --> 00:04:22,520\n给它一个名字和后缀名\n\n94\n00:04:23,309 --> 00:04:24,989\n点击上方的保存\n\n95\n00:04:24,989 --> 00:04:29,789\n那么呃这里我还是把这个文件保存在我的桌面\n\n96\n00:04:29,789 --> 00:04:32,549\n我先为他新建一个文件夹\n\n97\n00:04:32,549 --> 00:04:33,789\n用来存放它\n\n98\n00:04:33,789 --> 00:04:39,090\n这个文件夹我就把它命名为new吧\n\n99\n00:04:40,230 --> 00:04:44,130\n然后呢我们把这个文件命名为min\n\n100\n00:04:44,130 --> 00:04:46,770\nmin就是它是入口文件的意思\n\n101\n00:04:46,770 --> 00:04:52,389\n后缀名呢写为点C点C表明它是一个原文件\n\n102\n00:04:52,389 --> 00:04:54,730\n那么这个文件除了命名为min\n\n103\n00:04:54,730 --> 00:04:56,470\n你还可以按照自己的喜好\n\n104\n00:04:56,470 --> 00:04:58,730\n可能比如说有的人才就把它命名为123\n\n105\n00:04:58,730 --> 00:04:59,690\n这没有关系\n\n106\n00:04:59,690 --> 00:05:02,140\n但是后缀名一定要是点C\n\n107\n00:05:02,140 --> 00:05:03,780\n为什么的话\n\n108\n00:05:03,780 --> 00:05:05,240\n我这里就不做过多的解释\n\n109\n00:05:05,240 --> 00:05:08,020\n感兴趣的同学可以自己去找一些C语言的课程\n\n110\n00:05:08,020 --> 00:05:09,560\n来看一下\n\n111\n00:05:09,960 --> 00:05:13,320\n那么现在我们就已经在我们的电脑上创建了\n\n112\n00:05:13,320 --> 00:05:17,430\n一个名叫min点C可以编写的文件\n\n113\n00:05:17,430 --> 00:05:19,370\n但是这个文件可以看到\n\n114\n00:05:19,370 --> 00:05:21,510\n它还没有出现在我们的table中\n\n115\n00:05:21,510 --> 00:05:25,140\n我们要把它加入到我们的table中\n\n116\n00:05:25,140 --> 00:05:27,710\n这一步该怎么操作呢\n\n117\n00:05:28,190 --> 00:05:32,050\n我们点击想要把它加入进去的文件夹\n\n118\n00:05:32,050 --> 00:05:35,159\n然后选择ADD file into it\n\n119\n00:05:35,159 --> 00:05:37,639\n这个时候就打开这个窗口\n\n120\n00:05:37,639 --> 00:05:40,719\n让你选择你想要加入的文件\n\n121\n00:05:40,719 --> 00:05:46,700\n你把刚刚保存的点C文件在这个窗口中找到\n\n122\n00:05:46,700 --> 00:05:47,900\n并且选择它\n\n123\n00:05:47,900 --> 00:05:49,380\n点击确定之后\n\n124\n00:05:49,380 --> 00:05:51,200\n我们刚刚创建了这个文件\n\n125\n00:05:51,200 --> 00:05:54,270\n就已经被放入到了我们table中\n\n126\n00:05:54,270 --> 00:05:55,970\n就像现在这样\n\n127\n00:05:55,970 --> 00:05:58,470\n那么这个时候大家肯定又兴奋了\n\n128\n00:05:58,470 --> 00:06:01,430\n说哎我们终于可以开始写代码了\n\n129\n00:06:01,430 --> 00:06:03,169\n你看你又着急\n\n130\n00:06:03,169 --> 00:06:05,889\n那么光有一个点C文件是不够的\n\n131\n00:06:05,889 --> 00:06:09,089\n我们还需要一个点H文件作为头文件\n\n132\n00:06:09,089 --> 00:06:11,350\n和这个原文件配合\n\n133\n00:06:11,350 --> 00:06:14,810\n那么这个源文件和头文件它们是什么关系\n\n134\n00:06:14,810 --> 00:06:16,290\n又是什么意思呢\n\n135\n00:06:16,290 --> 00:06:19,030\n我这里也不做过多的解释呃\n\n136\n00:06:19,030 --> 00:06:21,590\n感兴趣的同学还是去找一个C语言的课程\n\n137\n00:06:21,590 --> 00:06:22,570\n学习一下\n\n138\n00:06:22,570 --> 00:06:23,530\n那么在这里\n\n139\n00:06:23,530 --> 00:06:25,150\n我们快速的创建一个\n\n140\n00:06:25,150 --> 00:06:28,910\n和这个原文件同名的头文件\n\n141\n00:06:28,910 --> 00:06:31,560\n然后把它保存在电脑中\n\n142\n00:06:31,960 --> 00:06:35,880\n头文件的话呢就不需要加入到这个table中了\n\n143\n00:06:35,880 --> 00:06:39,600\n因为它不是作为一个函数编写的文件\n\n144\n00:06:39,600 --> 00:06:42,940\n我们函数编写都是在原文件中进行的\n\n145\n00:06:42,940 --> 00:06:45,200\n所以我们就不需要把它放到table中\n\n146\n00:06:45,200 --> 00:06:48,600\n方便我们打开编写这样子\n\n147\n00:06:48,920 --> 00:06:52,080\n但是呢我们需要告诉我们的软件\n\n148\n00:06:52,080 --> 00:06:56,560\n它在哪里可以找到这些源文件和头文件\n\n149\n00:06:57,580 --> 00:07:00,320\n我们需要在这个窗口\n\n150\n00:07:00,320 --> 00:07:05,480\n将我们保存文件的文件夹的路径加入进去\n\n151\n00:07:05,480 --> 00:07:07,100\n告知软件\n\n152\n00:07:07,850 --> 00:07:10,650\n点击OK就可以了\n\n153\n00:07:11,670 --> 00:07:15,919\n那么现在我们就可以开始我们代码的编写了\n\n154\n00:07:15,919 --> 00:07:19,459\n可以看到我们现在的文件中是一行字都没有的\n\n155\n00:07:19,459 --> 00:07:23,140\n也就是意味着我们要完全从零开始写\n\n156\n00:07:23,140 --> 00:07:24,980\n那么我的建议是\n\n157\n00:07:24,980 --> 00:07:27,160\n如果你是第一次接触开发版\n\n158\n00:07:27,160 --> 00:07:30,970\n或者说接触这代码的编写的话\n\n159\n00:07:30,970 --> 00:07:33,950\n最好还是不要从零开始写\n\n160\n00:07:33,950 --> 00:07:38,830\n因为C语言它对于语法和格式的要求非常严格\n\n161\n00:07:38,830 --> 00:07:40,950\n所以在编写的过程中\n\n162\n00:07:40,950 --> 00:07:42,790\n小白特别容易出错\n\n163\n00:07:42,790 --> 00:07:46,200\n然后就导致程序没有办法跑通\n\n164\n00:07:46,200 --> 00:07:51,850\n即使是想要实现一个点亮小灯泡这样简单的哦\n\n165\n00:07:51,850 --> 00:07:55,590\n嗯功能也会比较困难\n\n166\n00:07:55,590 --> 00:07:56,970\n所以我的建议是\n\n167\n00:07:56,970 --> 00:08:03,569\n我们直接在一个已经开发了一定程度的程序\n\n168\n00:08:03,569 --> 00:08:06,569\n上面进行编写\n\n169\n00:08:07,300 --> 00:08:09,400\n那么我这里给大家打开\n\n170\n00:08:09,400 --> 00:08:14,340\n一个已经写好了一些代码和可以调用的函数\n\n171\n00:08:14,340 --> 00:08:14,900\n的项目\n\n172\n00:08:14,900 --> 00:08:16,860\n给大家看一下\n\n173\n00:08:34,419 --> 00:08:36,458\n这个项目呢非常的简单\n\n174\n00:08:36,458 --> 00:08:39,299\n它包含的函数只有两个\n\n175\n00:08:39,299 --> 00:08:41,849\n一个是让led灯亮\n\n176\n00:08:41,849 --> 00:08:45,249\n另一个呢是让OLED显示屏显示\n\n177\n00:08:45,249 --> 00:08:46,849\n我们编辑好的词句\n\n178\n00:08:46,849 --> 00:08:49,279\n我个人认为是比较简洁呃\n\n179\n00:08:49,279 --> 00:08:53,500\n适合小白理解并且学习的\n\n180\n00:08:53,500 --> 00:08:57,880\n那么我也已经把这个项目上传到了我的GITHUB上面\n\n181\n00:08:57,880 --> 00:09:01,440\n大家可以在我的GITHUB中下载\n\n182\n00:09:01,440 --> 00:09:03,520\n并且打开这个项目\n\n183\n00:09:03,520 --> 00:09:07,959\n我们接下来也用这个项目进行第一次的开发\n\n184\n00:09:07,959 --> 00:09:12,679\n让我们的led灯在面包板上点亮\n\n185\n00:09:16,680 --> 00:09:18,160\n把文件下载下来\n\n186\n00:09:18,160 --> 00:09:20,180\n就是一个像这样子的压缩包\n\n187\n00:09:20,180 --> 00:09:23,030\n把它解压就可以使用了\n\n188\n00:09:23,030 --> 00:09:26,390\n有的老师把直接使用一个已有的项目\n\n189\n00:09:26,390 --> 00:09:27,690\n进行新开发\n\n190\n00:09:27,690 --> 00:09:30,940\n这样创建新项目的方式称为移植\n\n191\n00:09:30,940 --> 00:09:33,530\n那么我觉得还蛮形象的\n\n192\n00:09:33,530 --> 00:09:36,630\n这里我们也来愉快的移植一下\n\n193\n00:09:36,630 --> 00:09:38,370\n移植就很简单了\n\n194\n00:09:38,370 --> 00:09:41,250\n直接复制这个已有的项目\n\n195\n00:09:41,250 --> 00:09:45,170\n然后把它命名为我们新项目的名字\n\n196\n00:09:45,170 --> 00:09:50,370\n比如说我这里给它取名为led light哈\n\n197\n00:09:50,370 --> 00:09:54,890\n然后打开我们移植的项目\n\n198\n00:10:04,180 --> 00:10:06,020\n打开这个example文件\n\n199\n00:10:06,020 --> 00:10:06,820\n就可以看到\n\n200\n00:10:06,820 --> 00:10:11,849\n我们这个项目其实是实现了一个让OLED显示\n\n201\n00:10:11,849 --> 00:10:15,360\n我们已经编辑好的文字这样一个项目\n\n202\n00:10:15,360 --> 00:10:19,520\n那么我们现在是需要让我们的led灯点亮\n\n203\n00:10:19,520 --> 00:10:21,900\n那我们把这些内容全部都删掉\n\n204\n00:10:21,900 --> 00:10:24,080\n从头开始\n\n205\n00:10:27,200 --> 00:10:31,360\n然后在这个table里面可以看到\n\n206\n00:10:31,360 --> 00:10:35,780\n项目其实已经写好了一个led灯的函数\n\n207\n00:10:35,780 --> 00:10:38,290\n那我们先来打开看一下这个函数\n\n208\n00:10:38,290 --> 00:10:40,010\n它是定义了什么\n\n209\n00:10:40,010 --> 00:10:41,840\n每一句话都是什么意思\n\n210\n00:10:41,840 --> 00:10:44,980\n首先呢它是定义了一个方法\n\n211\n00:10:44,980 --> 00:10:47,980\n名字叫做l led呃\n\n212\n00:10:47,980 --> 00:10:48,640\nIn it\n\n213\n00:10:48,640 --> 00:10:50,800\n这个就是initiation的意思\n\n214\n00:10:50,800 --> 00:10:52,339\n初始化\n\n215\n00:10:52,459 --> 00:10:56,359\n所以这里是想要实现一个对我们指定\n\n216\n00:10:56,359 --> 00:11:00,370\n用于点亮led灯接口的GPIO口\n\n217\n00:11:00,370 --> 00:11:03,130\n实现初始化的一个方法\n\n218\n00:11:03,130 --> 00:11:04,830\n嗯然后往下看\n\n219\n00:11:04,830 --> 00:11:10,410\n它的第一行其实是定义了一个结构体变量啊\n\n220\n00:11:10,410 --> 00:11:11,690\n什么叫结构体变量\n\n221\n00:11:11,690 --> 00:11:13,270\n我们就先不去管\n\n222\n00:11:13,270 --> 00:11:16,170\n只需要知道一定要写这样一句话就行了\n\n223\n00:11:16,170 --> 00:11:17,350\n然后第二句话\n\n224\n00:11:17,350 --> 00:11:20,960\nRCCRCC是我们之前提到的时钟\n\n225\n00:11:20,960 --> 00:11:28,169\n他第二句话的意思就是使A端口的时钟赋能\n\n226\n00:11:28,169 --> 00:11:30,140\n我觉得可以理解为\n\n227\n00:11:30,140 --> 00:11:32,900\n你家里不是有那种总闸开关吗\n\n228\n00:11:32,900 --> 00:11:38,579\n我们这里就是把我们需要的开关的总闸打开\n\n229\n00:11:39,139 --> 00:11:40,859\n接下来的三句话呢\n\n230\n00:11:40,859 --> 00:11:45,519\n则是配置了我们GPIO引脚的三个参数\n\n231\n00:11:45,519 --> 00:11:52,210\n这三个参数呢分别是名字频率和模式\n\n232\n00:11:52,610 --> 00:11:54,410\n那么在名字那一行\n\n233\n00:11:54,410 --> 00:11:58,330\n我们是指定配置的是一号引脚\n\n234\n00:11:58,330 --> 00:12:02,890\n结合上一行RCC时钟端口的序列号\n\n235\n00:12:02,890 --> 00:12:03,930\n一号序列号\n\n236\n00:12:03,930 --> 00:12:04,970\nA号序列号\n\n237\n00:12:04,970 --> 00:12:11,190\n也就是说我们指定打开GPRIOA端口的一号迎脚\n\n238\n00:12:11,550 --> 00:12:12,670\n频率的设置\n\n239\n00:12:12,670 --> 00:12:15,550\n对于点亮led灯泡并没有什么用\n\n240\n00:12:15,550 --> 00:12:17,250\n但是还是需要设置\n\n241\n00:12:17,250 --> 00:12:19,570\n所以这里就是简单设置了一个\n\n242\n00:12:19,570 --> 00:12:21,790\n50兆赫兹的频率\n\n243\n00:12:21,790 --> 00:12:25,119\n能接下来呢是这个模式\n\n244\n00:12:25,119 --> 00:12:28,920\n模式呢设置的是普通的推挽输出模式\n\n245\n00:12:28,920 --> 00:12:34,710\n推挽输出模式比较适用于简单高低电平的输除\n\n246\n00:12:36,510 --> 00:12:39,470\n那么除了这里使用到的推挽输出\n\n247\n00:12:39,470 --> 00:12:41,170\nGPIO引脚\n\n248\n00:12:41,170 --> 00:12:43,350\n还有另外三种输出模式\n\n249\n00:12:43,350 --> 00:12:45,400\n分别是开漏输出\n\n250\n00:12:45,400 --> 00:12:51,139\n开路复用输出和推挽复用输出这三种输出模式\n\n251\n00:12:51,719 --> 00:12:53,519\n这里暂时还不用用到\n\n252\n00:12:53,519 --> 00:12:57,150\n所以就不过多的介绍呃\n\n253\n00:12:57,150 --> 00:12:59,770\n我们把这些参数都设置好后\n\n254\n00:12:59,770 --> 00:13:03,170\n通过最后一行GPIUINIT\n\n255\n00:13:03,170 --> 00:13:06,970\n把我们的数值传回这个方法中\n\n256\n00:13:06,970 --> 00:13:11,850\n那么这就是这个简单的led引脚\n\n257\n00:13:11,850 --> 00:13:16,290\n初始化函数的意思和含义了\n\n258\n00: