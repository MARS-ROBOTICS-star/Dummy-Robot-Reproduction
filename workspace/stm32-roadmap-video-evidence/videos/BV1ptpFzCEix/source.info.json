4) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1ptpFzCEix/"}}, {"url": "https://upos-sz-estgcos.bilivideo.com/upgcxcode/82/66/32380816682/32380816682-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&deadline=1789976128&nbs=1&platform=pc&trid=e33d0d2d6e134d68892709c2cdd23e0u&mid=3461562375342187&gen=playurlv3&os=estgcos&og=cos&uipk=5&oi=664447097&upsig=d9b714a6a9ad22a3b377ba399ddd25e9&uparams=e,deadline,nbs,platform,trid,mid,gen,os,og,uipk,oi&bvc=vod&nettype=0&bw=139271&lrs=-1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&f=u_0_0&qn_dyeid=ab1fb5028b4cdc62002786536ab0c220&agrr=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 139.076, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 139.076, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 6753287, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1ptpFzCEix/"}}], "duration": 388.466, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/32380816682.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,160 --> 00:00:04,180\n这期是我的复盘和经验总结\n\n2\n00:00:04,180 --> 00:00:06,920\n这期总结的经验就是\n\n3\n00:00:06,920 --> 00:00:10,720\n我后悔当初大学时代跟着开发版教程\n\n4\n00:00:10,720 --> 00:00:12,440\n一步步学单片机\n\n5\n00:00:12,440 --> 00:00:15,280\n如果当初我选择某个开源项目\n\n6\n00:00:15,280 --> 00:00:17,080\n也许进步会更快\n\n7\n00:00:17,080 --> 00:00:18,900\n为什么这么说\n\n8\n00:00:18,900 --> 00:00:23,780\n大学期间我购买过五一开发版和三二开发版\n\n9\n00:00:23,780 --> 00:00:29,830\n分别是这个这个买到开发版\n\n10\n00:00:29,830 --> 00:00:32,870\n它会有很多配套的历程以及对应的视频\n\n11\n00:00:32,870 --> 00:00:36,590\n每个视频都是几10分钟起\n\n12\n00:00:37,110 --> 00:00:41,590\n当初我是一步步跟着这个实验做下来\n\n13\n00:00:41,590 --> 00:00:44,130\n也就是说如果做完一个实验的话\n\n14\n00:00:44,130 --> 00:00:45,330\n光是看视频\n\n15\n00:00:45,330 --> 00:00:48,070\n那就一个小时花去了\n\n16\n00:00:48,070 --> 00:00:50,170\n然后还得写代码\n\n17\n00:00:50,410 --> 00:00:52,970\n然后调试跟着他的历程来调试\n\n18\n00:00:54,330 --> 00:00:57,340\n所以说如果做完一个历程的话\n\n19\n00:00:57,340 --> 00:00:59,820\n大概需要花费一天\n\n20\n00:01:02,180 --> 00:01:04,259\n同样3号的开发版\n\n21\n00:01:04,259 --> 00:01:06,139\n他的教程也是非常的多\n\n22\n00:01:06,139 --> 00:01:07,219\n历程非常多\n\n23\n00:01:07,219 --> 00:01:08,819\n知识点也很多\n\n24\n00:01:08,819 --> 00:01:10,379\n如果一个跟下来的话\n\n25\n00:01:10,379 --> 00:01:13,139\n那可能要花好几个月吧\n\n26\n00:01:15,280 --> 00:01:17,460\n我学完这个开板之后呢\n\n27\n00:01:17,460 --> 00:01:18,800\n有什么体验\n\n28\n00:01:18,800 --> 00:01:22,280\n体验就是说他的教程章节多\n\n29\n00:01:22,280 --> 00:01:23,640\n视频长\n\n30\n00:01:24,000 --> 00:01:26,780\n每每学一个知识点都要花很多的时间\n\n31\n00:01:26,780 --> 00:01:31,459\n其次就是说学完开发版的数学教程周期很长\n\n32\n00:01:32,539 --> 00:01:33,899\n其次呢\n\n33\n00:01:35,190 --> 00:01:36,670\n边学边做\n\n34\n00:01:36,670 --> 00:01:38,030\n让我没有底气\n\n35\n00:01:38,030 --> 00:01:38,930\n什么底气\n\n36\n00:01:38,930 --> 00:01:42,920\n也就是说我的实验历程跑成功了\n\n37\n00:01:42,920 --> 00:01:47,000\n但是我不知道跑成功是因为我参照的历程\n\n38\n00:01:47,000 --> 00:01:48,040\n历程的作用\n\n39\n00:01:48,040 --> 00:01:49,800\n还是我自身实力的作用\n\n40\n00:01:49,800 --> 00:01:52,120\n我对这个是不确定的\n\n41\n00:01:53,920 --> 00:01:56,890\n所以在这以上三点之下\n\n42\n00:01:56,890 --> 00:02:00,450\n我最终是没有把所有历程跑完\n\n43\n00:02:00,450 --> 00:02:04,930\n没有坚持学完配套的历程\n\n44\n00:02:06,050 --> 00:02:07,870\n那大学毕业之后呢\n\n45\n00:02:07,870 --> 00:02:10,250\n就要开始工作\n\n46\n00:02:11,700 --> 00:02:15,590\n这是我工作中用到的这个单片机项目\n\n47\n00:02:15,590 --> 00:02:17,190\n分别用过STC\n\n48\n00:02:17,190 --> 00:02:21,120\n也就是说五一的项目用到过这些外设\n\n49\n00:02:21,120 --> 00:02:24,400\n还有三二的用到过这些外设\n\n50\n00:02:24,400 --> 00:02:29,000\n最近的一个是国产的一个芯片\n\n51\n00:02:29,400 --> 00:02:30,320\n还挺复杂的\n\n52\n00:02:30,320 --> 00:02:32,800\n这个外设是USB2.0\n\n53\n00:02:32,800 --> 00:02:33,620\n3.0的传输\n\n54\n00:02:33,620 --> 00:02:38,550\n以及厂家自定义的一些其他的外设\n\n55\n00:02:39,830 --> 00:02:41,430\n那前面我提到过\n\n56\n00:02:41,430 --> 00:02:44,330\n当初是连5132都没有学完\n\n57\n00:02:44,330 --> 00:02:47,370\n我当初连care都没有学会\n\n58\n00:02:47,370 --> 00:02:48,815\n很熟练的用\n\n59\n00:02:49,630 --> 00:02:52,130\n当我面对工作中的项目的时候\n\n60\n00:02:52,130 --> 00:02:55,390\n是直接面对新的芯片\n\n61\n00:02:55,390 --> 00:02:56,290\n新的国产芯片\n\n62\n00:02:56,290 --> 00:03:00,890\n以及国产芯片对应的新的IDE集成开发环境\n\n63\n00:03:03,040 --> 00:03:06,220\n当初学开发版都没有学完\n\n64\n00:03:06,220 --> 00:03:09,080\n那现在怎么有能力来学这个\n\n65\n00:03:09,080 --> 00:03:11,690\n来做完公司的项目呢\n\n66\n00:03:12,129 --> 00:03:14,729\n但是呢这些担忧都是多余的\n\n67\n00:03:15,809 --> 00:03:18,030\n做完这个公司的项目\n\n68\n00:03:18,430 --> 00:03:21,790\n我发现即使我没有学完51232的项目\n\n69\n00:03:21,790 --> 00:03:24,090\n我也一样可以做公司的项目\n\n70\n00:03:24,090 --> 00:03:26,870\n其次即使国产芯片\n\n71\n00:03:26,870 --> 00:03:30,449\n它没有市面上的资料那么全不\n\n72\n00:03:30,449 --> 00:03:31,749\n比如五一和三二的资料\n\n73\n00:03:31,749 --> 00:03:33,649\n网上一搜都是一大把的\n\n74\n00:03:33,649 --> 00:03:35,209\n那么没有资料\n\n75\n00:03:35,209 --> 00:03:36,289\n或者说资料非常的少\n\n76\n00:03:36,289 --> 00:03:38,440\n我也一样可以把项目做完\n\n77\n00:03:38,440 --> 00:03:39,920\n这说明什么呀\n\n78\n00:03:39,920 --> 00:03:42,400\n说明你完成项目的能力\n\n79\n00:03:42,400 --> 00:03:46,280\n并不需要把这些所有历程都跑完\n\n80\n00:03:46,860 --> 00:03:48,840\n当初是自己多虑了\n\n81\n00:03:48,840 --> 00:03:51,950\n那我当初为什么要跟着教程学吗\n\n82\n00:03:51,950 --> 00:03:54,090\n因为周围的人都是买开发板\n\n83\n00:03:54,090 --> 00:03:54,890\n然后跟着教程学\n\n84\n00:03:54,890 --> 00:03:57,470\n我是属于从众的心理\n\n85\n00:03:57,470 --> 00:03:59,330\n其次呢当时的心理就认为\n\n86\n00:04:00,570 --> 00:04:03,650\n我就没办法掌握这些单片机\n\n87\n00:04:03,650 --> 00:04:05,450\n如果我不学完所有知识点\n\n88\n00:04:05,450 --> 00:04:10,040\n那么我就没办法在工作中应付项目开发\n\n89\n00:04:10,360 --> 00:04:13,840\n其实就是说如果我不这样子跟着开发板学的话\n\n90\n00:04:13,840 --> 00:04:16,180\n我也没有其他的学习方法了\n\n91\n00:04:16,180 --> 00:04:18,180\n这就是我当初为什么买开发版\n\n92\n00:04:18,180 --> 00:04:20,560\n想要一步步学的原因\n\n93\n00:04:20,560 --> 00:04:24,770\n那经历了工作中的项目之后\n\n94\n00:04:25,010 --> 00:04:29,010\n我才发现项目它不需要用到开发版\n\n95\n00:04:29,010 --> 00:04:31,410\n所有的知识点\n\n96\n00:04:32,470 --> 00:04:36,030\n其次你不会的知识点\n\n97\n00:04:36,030 --> 00:04:38,860\n你在网络上也是能够找到的\n\n98\n00:04:38,860 --> 00:04:40,620\n虽然说不同型号的单片机\n\n99\n00:04:40,620 --> 00:04:45,220\n但是呢其实背后的一些知识都都是通用的\n\n100\n00:04:45,220 --> 00:04:47,110\n网络上都能找到\n\n101\n00:04:47,110 --> 00:04:49,370\n其次就是说你做项目的话\n\n102\n00:04:49,370 --> 00:04:52,270\n你每解决一个问题都会让你信心大增\n\n103\n00:04:52,270 --> 00:04:54,750\n每解决一个bug也会让你信心大增\n\n104\n00:04:54,750 --> 00:04:57,890\n而不是像跟着开发板学习一样\n\n105\n00:04:57,890 --> 00:04:59,930\n边做还边没有底气\n\n106\n00:04:59,930 --> 00:05:05,880\n不知道是历城在起作用还是自己的实力如此\n\n107\n00:05:08,000 --> 00:05:10,880\n那么经过学校的学习\n\n108\n00:05:10,880 --> 00:05:14,600\n学校跟着开发版的学习以及工作中的项目学习\n\n109\n00:05:15,570 --> 00:05:16,690\n两相对比\n\n110\n00:05:16,690 --> 00:05:18,130\n我总结了什么\n\n111\n00:05:18,130 --> 00:05:19,730\n我说对于我来而言\n\n112\n00:05:19,730 --> 00:05:20,690\n时间紧张\n\n113\n00:05:20,690 --> 00:05:24,235\n那么做中学就要比一步步学要进步快\n\n114\n00:05:25,050 --> 00:05:26,170\n边做边学\n\n115\n00:05:26,170 --> 00:05:29,810\n不要等所有的知识都掌握齐全了\n\n116\n00:05:29,810 --> 00:05:31,310\n才开始做项目\n\n117\n00:05:31,310 --> 00:05:32,450\n工作中的项目\n\n118\n00:05:32,450 --> 00:05:34,145\n他是不会等你的\n\n119\n00:05:35,110 --> 00:05:40,460\n那么以后我将如何应对没有掌握的技能呢\n\n120\n00:05:40,460 --> 00:05:45,720\n我决定是使用两种方法当中的这个边做边学\n\n121\n00:05:45,720 --> 00:05:48,240\n因为我毕竟是时间紧张的人\n\n122\n00:05:48,240 --> 00:05:50,880\n我把它称为自然主义的学习法\n\n123\n00:05:50,880 --> 00:05:53,960\n也就是说模仿遇到什么就学什么\n\n124\n00:05:53,960 --> 00:05:56,040\n学习过程中可以是碎片化的\n\n125\n00:05:56,040 --> 00:05:58,860\n然后你只要碎片积累的够多\n\n126\n00:05:58,860 --> 00:06:00,940\n他就会积少成多\n\n127\n00:06:02,020 --> 00:06:04,420\n而如果时间足够的话\n\n128\n00:06:04,420 --> 00:06:09,550\n那么你就可以更注重结构体系化的去学\n\n129\n00:06:10,210 --> 00:06:11,450\n这样学有一个好处\n\n130\n00:06:11,450 --> 00:06:14,450\n那就是说因为你的你的知识已经成\n\n131\n00:06:14,450 --> 00:06:15,370\n已经成体系了\n\n132\n00:06:15,370 --> 00:06:20,570\n那么你的创造力相比较自然主义的话会更高\n\n133\n00:06:20,570 --> 00:06:23,640\n更强好的\n\n134\n00:06:23,640 --> 00:06:25,420\n这就是我的经验总结\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1ptpFzCEix/", "webpage_url_basename": "BV1ptpFzCEix", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "thumbnails": [{"url": "http://i1.hdslb.com/bfs/archive/9cda40ad66784f76e709a2723e664e36c6af81fa.jpg", "id": "0"}], "display_id": "BV1ptpFzCEix", "fulltitle": "直接做单片机项目，不要等全学会了才开始", "duration_string": "6:28", "upload_date": "20250914", "epoch": 1789968933, "format": "720P 准高清+30280 - audio only", "format_id": "30064+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 12401291, "tbr": 255.39, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 139.076, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 116.314, "_type": "video", "_version": {"version": "2026.08.30.232658", "release_git_head": "bbc809a1161d3bfca51fa36f59dda35556ee85a0", "repository": "yt-dlp/yt-dlp-nightly-builds"}}