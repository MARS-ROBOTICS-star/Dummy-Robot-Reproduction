0630C03B175654infoc&build=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "hev1.1.6.L120.90", "acodec": "none", "dynamic_range": "SDR", "tbr": 272.853, "quality": 64, "format_id": "30066", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 272.853, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 18458880, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1dPn2zZEec/"}}, {"url": "https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/17/45/32745064517/32745064517-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&og=cos&nbs=1&platform=pc&trid=04afcf33d005451fb9db19d6e498134u&gen=playurlv3&os=cosbv&uipk=5&deadline=1789987387&oi=664447097&mid=3461562375342187&upsig=7caba262ae02e53deb2417b1afa6794c&uparams=e,og,nbs,platform,trid,gen,os,uipk,deadline,oi,mid&bvc=vod&nettype=0&bw=501324&lrs=-1&qn_dyeid=32e1199b0e287e2f00d8de636ab0ee1b&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&f=u_0_0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 501.105, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 501.105, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 33900442, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1dPn2zZEec/"}}], "duration": 541.211, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/32745064517.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,140 --> 00:00:01,720\n嵌入式零基础怎么学\n\n2\n00:00:01,720 --> 00:00:02,820\n能混进大厂\n\n3\n00:00:02,820 --> 00:00:04,600\n秒杀所有应届生\n\n4\n00:00:04,600 --> 00:00:06,220\n作为双非野鸡大学\n\n5\n00:00:06,220 --> 00:00:08,840\n被学历歧视到拿下top车企offer\n\n6\n00:00:08,840 --> 00:00:10,510\n我应该最有发言权\n\n7\n00:00:10,510 --> 00:00:12,730\n这条路看上去确实反常时\n\n8\n00:00:12,730 --> 00:00:14,610\n执行起来也极度痛苦\n\n9\n00:00:14,610 --> 00:00:16,030\n但在学历贬值\n\n10\n00:00:16,030 --> 00:00:17,290\n岗位缩减的今天\n\n11\n00:00:17,290 --> 00:00:19,970\n这确实是投入产出比最高的学习路线\n\n12\n00:00:19,970 --> 00:00:20,950\n没有之一\n\n13\n00:00:20,950 --> 00:00:22,530\n而这条路的第一步\n\n14\n00:00:22,530 --> 00:00:28,530\n一个可能颠覆你认知的建议就是忘了五一单片机在2025年\n\n15\n00:00:28,530 --> 00:00:31,890\n对于任何一个想进入主流嵌入式岗位的同学来说\n\n16\n00:00:31,890 --> 00:00:35,700\n从五一开始绝对是那条最慢最绕的弯路\n\n17\n00:00:35,700 --> 00:00:39,180\n这期视频为保持最大信息输出效率\n\n18\n00:00:39,180 --> 00:00:42,200\n我不会给你讲解任何一个技术点的细节\n\n19\n00:00:42,200 --> 00:00:45,280\n只系统地讲解每一段嵌入式的关键节点\n\n20\n00:00:45,280 --> 00:00:48,690\n我会给你一张真正清晰高效的路线图\n\n21\n00:00:48,690 --> 00:00:51,430\n告诉你在每个阶段应该看什么书\n\n22\n00:00:51,430 --> 00:00:52,350\n跟什么课\n\n23\n00:00:52,350 --> 00:00:53,610\n用什么工具\n\n24\n00:00:53,610 --> 00:00:56,790\n以及最重要的建立什么样的认知\n\n25\n00:00:56,790 --> 00:00:59,810\n这能帮你避开市面上90%的坑\n\n26\n00:00:59,810 --> 00:01:01,650\n比我少绕几年的弯路\n\n27\n00:01:01,650 --> 00:01:03,030\n信息量会很大\n\n28\n00:01:03,030 --> 00:01:04,510\n建议你先点赞收藏\n\n29\n00:01:04,510 --> 00:01:06,225\n我们直接开始\n\n30\n00:01:08,160 --> 00:01:10,920\n第一阶段C语言学徒打好内功\n\n31\n00:01:10,920 --> 00:01:13,420\n我们整个过程分为四个阶段\n\n32\n00:01:13,420 --> 00:01:15,210\n就像打怪升级\n\n33\n00:01:15,210 --> 00:01:17,770\n而第一阶段也是最重要的一步\n\n34\n00:01:17,770 --> 00:01:19,350\n成为C语言学徒\n\n35\n00:01:19,350 --> 00:01:21,930\n这个阶段是唯一一个没有捷径\n\n36\n00:01:21,930 --> 00:01:23,690\n必须死磕的阶段\n\n37\n00:01:23,690 --> 00:01:26,030\n他的核心目标不是学会语法\n\n38\n00:01:26,030 --> 00:01:28,560\n而是建立起一种代码直觉\n\n39\n00:01:28,560 --> 00:01:32,640\n你写的每一行代码都要能清晰的在脑海中看到它\n\n40\n00:01:32,640 --> 00:01:34,509\n在内存中是如何运行的\n\n41\n00:01:34,509 --> 00:01:38,730\n这是区分普通程序员和优秀工程师的真正分水岭\n\n42\n00:01:38,730 --> 00:01:42,670\n学习资源我只给你最精简最权威的组合\n\n43\n00:01:42,670 --> 00:01:44,110\n避免你选择困难\n\n44\n00:01:44,110 --> 00:01:45,150\n关于书籍\n\n45\n00:01:45,150 --> 00:01:46,570\n两本足矣\n\n46\n00:01:46,570 --> 00:01:50,690\n第一本是C语言之父写的C程序设计语言\n\n47\n00:01:50,690 --> 00:01:51,530\n这是圣经\n\n48\n00:01:51,530 --> 00:01:52,630\n代码风格优雅\n\n49\n00:01:52,630 --> 00:01:54,050\n值得反复品读\n\n50\n00:01:54,050 --> 00:01:56,410\n第二本是C和指针\n\n51\n00:01:56,410 --> 00:02:00,289\n它能帮你把指针这个最难啃的骨头彻底搞明白\n\n52\n00:02:00,289 --> 00:02:01,189\n不要贪多\n\n53\n00:02:01,189 --> 00:02:02,409\n把这两本吃透\n\n54\n00:02:02,409 --> 00:02:06,200\n你的C语言功底就能超越90%的初学者\n\n55\n00:02:06,200 --> 00:02:07,600\n关于视频课程\n\n56\n00:02:07,600 --> 00:02:09,900\nB站上有很多免费的优质资源\n\n57\n00:02:09,900 --> 00:02:11,240\n我个人验证过\n\n58\n00:02:11,240 --> 00:02:13,320\n最适合初学者的有两个\n\n59\n00:02:13,320 --> 00:02:15,280\n郝斌老师的C语言教程\n\n60\n00:02:15,280 --> 00:02:17,780\n或者浙江大学翁凯老师的课程\n\n61\n00:02:17,780 --> 00:02:20,350\n这两个都是风评极好的入门课\n\n62\n00:02:20,350 --> 00:02:21,390\n内容扎实\n\n63\n00:02:21,390 --> 00:02:22,550\n二选一即可\n\n64\n00:02:22,550 --> 00:02:23,730\n千万不要多看\n\n65\n00:02:23,730 --> 00:02:24,910\n会浪费时间\n\n66\n00:02:24,910 --> 00:02:29,250\n开发工具直接用vs code或者visual studio社区版\n\n67\n00:02:29,250 --> 00:02:32,550\n不要在初学阶段纠结于各种复杂的IDE\n\n68\n00:02:32,550 --> 00:02:34,420\n先把语言本身学好\n\n69\n00:02:34,420 --> 00:02:35,660\n认知心法\n\n70\n00:02:35,660 --> 00:02:40,840\n这个阶段最容易犯的错误就是满足于学会if减else和for循环\n\n71\n00:02:40,840 --> 00:02:41,840\n我告诉你\n\n72\n00:02:41,840 --> 00:02:43,290\n那不叫会C语言\n\n73\n00:02:43,290 --> 00:02:45,890\n你必须把学习重心放在三个地方\n\n74\n00:02:45,890 --> 00:02:46,970\n指针的本质\n\n75\n00:02:46,970 --> 00:02:48,050\n内存的布局\n\n76\n00:02:48,050 --> 00:02:49,640\n结构体和位运算\n\n77\n00:02:49,640 --> 00:02:50,940\n你要反复问自己\n\n78\n00:02:50,940 --> 00:02:52,120\n指针变量占多大\n\n79\n00:02:52,120 --> 00:02:53,420\n内存函数\n\n80\n00:02:53,420 --> 00:02:55,600\n指针和指针数组有什么区别\n\n81\n00:02:55,600 --> 00:02:57,300\n一个程序在运行时\n\n82\n00:02:57,300 --> 00:02:59,380\n内存是如何划分成栈区\n\n83\n00:02:59,380 --> 00:03:01,320\n堆区全局区的便\n\n84\n00:03:01,320 --> 00:03:04,540\n当你能把这些问题像聊天一样讲出来时\n\n85\n00:03:04,540 --> 00:03:07,080\n你的内功才算真正打好了\n\n86\n00:03:07,080 --> 00:03:08,120\n第二阶段\n\n87\n00:03:08,120 --> 00:03:10,040\n点灯工程师驾驭硬件\n\n88\n00:03:10,040 --> 00:03:11,420\n当你C语言过关\n\n89\n00:03:11,420 --> 00:03:12,269\n恭喜你\n\n90\n00:03:12,269 --> 00:03:13,569\n可以进入第二阶段\n\n91\n00:03:13,569 --> 00:03:15,910\n成为一名光荣的点灯工程师\n\n92\n00:03:15,910 --> 00:03:19,530\n这个阶段的核心目标是学会阅读芯片手册\n\n93\n00:03:19,530 --> 00:03:23,040\n并把手册里的描述翻译成代码的能力\n\n94\n00:03:23,040 --> 00:03:26,100\n这是我当年能实现逆袭的关键能力\n\n95\n00:03:26,100 --> 00:03:28,900\n学习路径与资源MCU选择\n\n96\n00:03:28,900 --> 00:03:31,710\n我强烈推荐直接上手STM32\n\n97\n00:03:31,710 --> 00:03:32,830\n理由很简单\n\n98\n00:03:32,830 --> 00:03:33,990\n资料最丰富\n\n99\n00:03:33,990 --> 00:03:35,030\n社区最庞大\n\n100\n00:03:35,030 --> 00:03:36,350\n工作岗位最多\n\n101\n00:03:36,350 --> 00:03:39,720\n你遇到的任何问题在网上都能找到答案\n\n102\n00:03:39,720 --> 00:03:41,840\n这对初学者至关重要\n\n103\n00:03:41,840 --> 00:03:44,420\n开发版与课程不要自己去买裸板\n\n104\n00:03:44,420 --> 00:03:47,000\n一定要跟着一个成熟的课程体系走\n\n105\n00:03:47,000 --> 00:03:50,610\n国内做的最好的两家就是正点原子和野火\n\n106\n00:03:50,610 --> 00:03:54,760\n他们的视频教程配套开发版和文档都非常完善\n\n107\n00:03:54,760 --> 00:03:56,200\n跟着他们的课程\n\n108\n00:03:56,200 --> 00:03:58,580\n从点亮第一颗led灯开始\n\n109\n00:03:58,580 --> 00:04:00,080\n这个动作虽然简单\n\n110\n00:04:00,080 --> 00:04:01,190\n但意义非凡\n\n111\n00:04:01,190 --> 00:04:04,270\n它意味着你的整个开发链路全部打通了\n\n112\n00:04:04,270 --> 00:04:05,950\n核心外设清单\n\n113\n00:04:05,950 --> 00:04:10,209\n接下来你需要系统性地扫清这几个核心外设\n\n114\n00:04:10,209 --> 00:04:16,000\ng p I/O word串口中断定时器ADCSSPI和IC\n\n115\n00:04:16,000 --> 00:04:19,040\n你现在不需要理解他们每一个是干什么的\n\n116\n00:04:19,040 --> 00:04:22,369\n你只需要知道这是你必须攻克的山头\n\n117\n00:04:22,369 --> 00:04:25,430\n跟着课程一个一个去实现它们的功能\n\n118\n00:04:25,430 --> 00:04:31,150\n这个阶段你需要掌握KMDK这是STM32开发最主流的工具\n\n119\n00:04:31,150 --> 00:04:33,110\n你要学会用它进行编译\n\n120\n00:04:33,110 --> 00:04:34,760\n下载和基础的debug\n\n121\n00:04:34,760 --> 00:04:36,560\n点灯不是目的\n\n122\n00:04:36,560 --> 00:04:38,390\n只是一个结果验证\n\n123\n00:04:38,390 --> 00:04:42,270\n这个阶段真正的学习发生在你看懂芯片手册\n\n124\n00:04:42,270 --> 00:04:43,860\n并对照着手册\n\n125\n00:04:43,860 --> 00:04:45,520\n通过配置寄存器\n\n126\n00:04:45,520 --> 00:04:49,300\n最终让灯亮起来的过程是学会看官方文档\n\n127\n00:04:49,300 --> 00:04:52,260\n是嵌入式工程师最重要的核心能力\n\n128\n00:04:52,260 --> 00:04:53,560\n没有之一\n\n129\n00:04:53,560 --> 00:04:55,340\n你每学会一个外设\n\n130\n00:04:55,340 --> 00:04:57,020\n都是在强化这种能力\n\n131\n00:04:57,020 --> 00:04:58,040\n第三阶段\n\n132\n00:04:58,040 --> 00:04:59,840\n项目开发者构建系统\n\n133\n00:04:59,840 --> 00:05:02,330\n当你能熟练的玩转各种外设后\n\n134\n00:05:02,330 --> 00:05:04,450\n就将迎来一次关键的跃迁\n\n135\n00:05:04,450 --> 00:05:06,750\n从工程师进化为开发者\n\n136\n00:05:06,750 --> 00:05:10,830\n这次跃迁的标志就是学习并使用实时操作系统\n\n137\n00:05:10,830 --> 00:05:12,350\n也就是RT os\n\n138\n00:05:12,350 --> 00:05:14,880\n核心目标是建立系统思维\n\n139\n00:05:14,880 --> 00:05:19,520\n学会将复杂的项目拆解成多个独立任务并进行管理\n\n140\n00:05:19,520 --> 00:05:21,480\n关于学习路径与资源\n\n141\n00:05:21,480 --> 00:05:24,500\nRTOS选择从free TOS开始\n\n142\n00:05:24,500 --> 00:05:25,700\n它代码量少\n\n143\n00:05:25,700 --> 00:05:28,280\n开源免费是业界的标准之一\n\n144\n00:05:28,280 --> 00:05:32,360\n也是各大MCU厂商官方支持的系统视频课程\n\n145\n00:05:32,360 --> 00:05:37,100\n学习RT时我依然推荐野火或正点原子的配套课程\n\n146\n00:05:37,100 --> 00:05:40,220\n他们有专门的free TOS系列教程\n\n147\n00:05:40,220 --> 00:05:42,800\n会手把手教你如何移植系统\n\n148\n00:05:42,800 --> 00:05:45,070\n如何使用任务信号量\n\n149\n00:05:45,070 --> 00:05:47,700\n消息队列这些核心组件\n\n150\n00:05:47,700 --> 00:05:48,960\n书籍推荐\n\n151\n00:05:48,960 --> 00:05:51,480\n如果你想深入理解操作系统原理\n\n152\n00:05:51,480 --> 00:05:53,740\n为面试和长远发展打基础\n\n153\n00:05:53,740 --> 00:05:55,880\n可以阅读两本经典著作\n\n154\n00:05:55,880 --> 00:05:58,480\n操作系统概念和现代操作系统\n\n155\n00:05:58,480 --> 00:06:01,920\n这两本书会告诉你RTOS背后的设计哲学\n\n156\n00:06:01,920 --> 00:06:04,799\n让你在大厂面试中游刃有余\n\n157\n00:06:04,799 --> 00:06:06,479\n为什么要用RTOS\n\n158\n00:06:06,479 --> 00:06:08,550\n因为当你的项目变得复杂\n\n159\n00:06:08,550 --> 00:06:11,960\n只靠WIL1和中断代码会变成一团乱麻\n\n160\n00:06:11,960 --> 00:06:15,160\nRTL是让你从关注如何实现功能的层面\n\n161\n00:06:15,160 --> 00:06:18,650\n上升到关注如何组织和调度功能的层面\n\n162\n00:06:18,650 --> 00:06:22,490\n这个阶段你必须做一个完整的物联网项目来练手\n\n163\n00:06:22,490 --> 00:06:25,210\n比如联网的温湿度采集器\n\n164\n00:06:25,210 --> 00:06:26,990\n当你独立完成这个项目\n\n165\n00:06:26,990 --> 00:06:31,590\n把采集处理通信等多个任务管理得井井有条时\n\n166\n00:06:31,590 --> 00:06:34,890\n你的能力就真正超越了绝大多数初学者\n\n167\n00:06:34,890 --> 00:06:36,010\n第四阶段\n\n168\n00:06:36,010 --> 00:06:38,419\n系统架构师深化认知\n\n169\n00:06:38,419 --> 00:06:41,640\n第四阶段是成为一名系统架构师\n\n170\n00:06:41,640 --> 00:06:42,900\n到了这个阶段\n\n171\n00:06:42,900 --> 00:06:45,920\n你的核心目标是拥有技术选型的能力\n\n172\n00:06:45,920 --> 00:06:49,900\n能够根据产品的实际需求选择最合适的技术站\n\n173\n00:06:49,900 --> 00:06:51,380\n并预见其优劣\n\n174\n00:06:51,380 --> 00:06:53,620\n关于进阶方向与认知\n\n175\n00:06:53,620 --> 00:06:57,890\n嵌入式LINUX这不是一个要不要学的问题\n\n176\n00:06:57,890 --> 00:06:59,909\n而是什么时候学的问题\n\n177\n00:06:59,909 --> 00:07:02,529\n当你的产品需要复杂的人机交互\n\n178\n00:07:02,529 --> 00:07:04,909\n强大的网络功能或文件系统时\n\n179\n00:07:04,909 --> 00:07:06,929\n比如智能音箱路由器\n\n180\n00:07:06,929 --> 00:07:08,789\n你就必须上LINUX\n\n181\n00:07:08,789 --> 00:07:10,869\n你需要理解内核裁剪\n\n182\n00:07:10,869 --> 00:07:14,340\n文件系统构建和驱动开发的基本流程\n\n183\n00:07:14,340 --> 00:07:18,380\nFPGA在对性能和实时性要求极致的领域\n\n184\n00:07:18,380 --> 00:07:20,100\n比如高速信号处理\n\n185\n00:07:20,100 --> 00:07:21,560\n电机精准控制\n\n186\n00:07:21,560 --> 00:07:23,860\n纯软件已经无法满足需求\n\n187\n00:07:23,860 --> 00:07:25,770\n你会接触到FPGA\n\n188\n00:07:25,770 --> 00:07:27,910\n这开启了软硬结合的道路\n\n189\n00:07:27,910 --> 00:07:31,290\n高级专题还有很多能让你成为专家的领域\n\n190\n00:07:31,290 --> 00:07:32,770\n比如低功耗设计\n\n191\n00:07:32,770 --> 00:07:33,810\n嵌入式算法\n\n192\n00:07:33,810 --> 00:07:35,150\npad滤波等\n\n193\n00:07:35,150 --> 00:07:36,130\n信息安全等等\n\n194\n00:07:36,130 --> 00:07:41,460\n变这些都是能够让你在职业道路上拥有核心竞争力的独门绝技\n\n195\n00:07:41,460 --> 00:07:42,660\n到了这个阶段\n\n196\n00:07:42,660 --> 00:07:45,620\n学习的重点不再是具体的技术实现\n\n197\n00:07:45,620 --> 00:07:49,039\n而是理解不同技术的边界和适用场景\n\n198\n00:07:49,039 --> 00:07:50,339\n你要开始思考\n\n199\n00:07:50,339 --> 00:07:52,099\n为什么这个产品用LINUX\n\n200\n00:07:52,099 --> 00:07:53,390\n而不是rt2S\n\n201\n00:07:53,390 --> 00:07:56,890\n为什么这个场景必须用FPGA成本功耗\n\n202\n00:07:56,890 --> 00:07:59,909\n开发周期哪个是首要考虑因素\n\n203\n00:07:59,909 --> 00:08:01,829\n当你能回答这些问题时\n\n204\n00:08:01,829 --> 00:08:04,080\n你就具备了架构师的思维\n\n205\n00:08:04,080 --> 00:08:05,480\n听完这四个阶段\n\n206\n00:08:05,480 --> 00:08:07,820\n你可能会觉得要学的东西太多了\n\n207\n00:08:07,820 --> 00:08:09,750\n甚至有点不知所措\n\n208\n00:08:09,750 --> 00:08:10,610\n别担心\n\n209\n00:08:10,610 --> 00:08:11,890\n这是正常反应\n\n210\n00:08:11,890 --> 00:08:13,670\n罗马不是一天建成的\n\n211\n00:08:13,670 --> 00:08:16,530\n现在我请你忘掉后面三个阶段\n\n212\n00:08:16,530 --> 00:08:19,290\n你的整个世界里只需要专注一件事\n\n213\n00:08:19,290 --> 00:08:21,580\n扎扎实实的学好C语言B\n\n214\n00:08:21,580 --> 00:08:24,200\n这是你通往嵌入式世界的第一张\n\n215\n00:08:24,200 --> 00:08:26,220\n也是最重要的一张门票\n\n216\n00:08:26,220 --> 00:08:27,650\n把基础打牢\n\n217\n00:08:27,650 --> 00:08:29,490\n后面的路才能走得稳\n\n218\n00:08:29,490 --> 00:08:30,549\n走得远\n\n219\n00:08:30,549 --> 00:08:31,849\n为了方便大家\n\n220\n00:08:31,849 --> 00:08:34,249\n我把每个阶段的核心学习资源\n\n221\n00:08:34,249 --> 00:08:38,159\n推荐书籍和练手项目都整理成了一份文档\n\n222\n00:08:38,159 --> 00:08:39,559\n放在了评论区里\n\n223\n00:08:39,559 --> 00:08:41,308\n大家可以免费自取\n\n224\n00:08:41,308 --> 00:08:44,669\n这应该会是你收藏夹里最有价值的资料之一\n\n225\n00:08:44,669 --> 00:08:45,649\n一键三连\n\n226\n00:08:45,649 --> 00:08:46,829\n评论区告诉我\n\n227\n00:08:46,829 --> 00:08:48,169\n你想我讲什么\n\n228\n00:08:48,169 --> 00:08:51,770\n未来我会针对路线图中的每一个关键节点\n\n229\n00:08:51,770 --> 00:08:56,800\n比如指针rt4嵌入式LINUX出更详细的深度讲解视频\n\n230\n00:08:56,800 --> 00:08:58,960\n不想错过这些硬核干货的话\n\n231\n00:08:58,960 --> 00:09:00,020\n记得点个关注\n\n232\n00:09:00,020 --> 00:09:01,200\n我们下期再见\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1dPn2zZEec/", "webpage_url_basename": "BV1dPn2zZEec", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "thumbnails": [{"url": "http://i0.hdslb.com/bfs/archive/2f54a66d3bebcc9c386aec3301eee4bf59eb4f96.jpg", "id": "0"}], "display_id": "BV1dPn2zZEec", "fulltitle": "爆肝整理！b站最狠嵌入式学习路线", "duration_string": "9:01", "upload_date": "20250930", "epoch": 1789980191, "format": "720P 准高清+30280 - audio only", "format_id": "30064+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 43102043, "tbr": 637.12, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 501.105, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 136.015, "_type": "video", "_version": {"version": "2026.08.30.232658", "release_git_head": "bbc809a1161d3bfca51fa36f59dda35556ee85a0", "repository": "yt-dlp/yt-dlp-nightly-builds"}}