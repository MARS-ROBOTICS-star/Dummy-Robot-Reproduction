279f3fu&oi=664447097&upsig=4ad127c6a4f60c7479b9d21e999aefe8&uparams=e,deadline,platform,mid,gen,os,og,nbs,uipk,trid,oi&bvc=vod&nettype=0&bw=170319&lrs=-1&f=u_0_0&qn_dyeid=e1e60ae2995d28db006e3fec6ab0f036&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640028", "acodec": "none", "dynamic_range": "SDR", "tbr": 170.077, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 170.077, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 16454694, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1VG9ZYbEYQ/"}}], "duration": 773.988, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/28707717736.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,500 --> 00:00:01,520\nOK大家好\n\n2\n00:00:01,520 --> 00:00:05,360\n今天教一下大家怎么FARTS操作系统\n\n3\n00:00:05,360 --> 00:00:07,760\n移植到STM32F103\n\n4\n00:00:07,760 --> 00:00:09,660\nC8T6这个单片机上\n\n5\n00:00:09,660 --> 00:00:13,900\n然后首先我们进入FARTIST的官网啊\n\n6\n00:00:13,900 --> 00:00:16,219\n在我们搜索栏搜索\n\n7\n00:00:21,120 --> 00:00:22,660\n然后下载他的源码\n\n8\n00:00:22,660 --> 00:00:28,030\n第一个就是然后在右上角点击download后\n\n9\n00:00:28,030 --> 00:00:29,270\n然后第二个版本\n\n10\n00:00:29,270 --> 00:00:32,530\n然后download download完之后\n\n11\n00:00:32,530 --> 00:00:35,210\n然后就会有一个我们源码的版本\n\n12\n00:00:35,210 --> 00:00:37,350\nOK这就是我们源码的版本\n\n13\n00:00:37,350 --> 00:00:39,360\n这个就是我们源码文件\n\n14\n00:00:39,360 --> 00:00:43,519\n然后另外一个就是我们STM32的工程模板\n\n15\n00:00:43,519 --> 00:00:46,079\n然后本次的工程模板是使用的\n\n16\n00:00:46,079 --> 00:00:48,800\n江科大的工程模板\n\n17\n00:00:48,800 