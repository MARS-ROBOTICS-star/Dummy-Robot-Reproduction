D79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&f=u_0_0&qn_dyeid=4d2fa8bb22190d3000c1a4ad6ab0ee43&agrr=1&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "hev1.1.6.L120.90", "acodec": "none", "dynamic_range": "SDR", "tbr": 330.562, "quality": 64, "format_id": "30066", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 330.562, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 9926528, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1zu5e6NE9y/"}}, {"url": "https://upos-sz-mirrorcoso1.bilivideo.com/upgcxcode/31/52/38342755231/38342755231-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&og=cos&trid=6129cf1ce421407b9f8341fb9c37c14u&nbs=1&mid=3461562375342187&gen=playurlv3&uipk=5&oi=664447097&platform=pc&deadline=1789987427&os=coso1bv&upsig=f2935bab08ca19ff9eaac548af5c719e&uparams=e,og,trid,nbs,mid,gen,uipk,oi,platform,deadline,os&bvc=vod&nettype=0&bw=465649&lrs=-1&qn_dyeid=4d2fa8bb22190d3000c1a4ad6ab0ee43&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&f=u_0_0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1280, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 465.176, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 465.176, "resolution": "1280x720", "aspect_ratio": 1.78, "filesize_approx": 13968886, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1zu5e6NE9y/"}}], "duration": 240.234, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/38342755231.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:00,100 --> 00:00:02,500\n最近我大二做毕设的视频火了\n\n2\n00:00:02,500 --> 00:00:03,600\n很多人问我\n\n3\n00:00:03,600 --> 00:00:06,900\n你才大二怎么就开始接嵌入式毕设单了\n\n4\n00:00:06,900 --> 00:00:09,960\n其实我一开始也不是把所有知识都学完了\n\n5\n00:00:09,960 --> 00:00:11,320\n才敢去做项目\n\n6\n00:00:11,320 --> 00:00:14,280\n真正有用的是先把公共基础打好\n\n7\n00:00:14,280 --> 00:00:15,780\n然后尽早做项目\n\n8\n00:00:15,780 --> 00:00:17,689\n再根据目标选择方向\n\n9\n00:00:17,689 --> 00:00:20,620\n这期我就把嵌入式学习路线讲清楚\n\n10\n00:00:20,620 --> 00:00:22,580\n哪些是新手都建议学的\n\n11\n00:00:22,580 --> 00:00:24,580\n哪些是后面按方向选择的\n\n12\n00:00:24,580 --> 00:00:26,840\n避免你一上来就觉得什么都要学\n\n13\n00:00:26,840 --> 00:00:28,100\n直接被劝退\n\n14\n00:00:28,100 --> 00:00:29,520\n先纠正一个误区\n\n15\n00:00:29,520 --> 00:00:32,940\n很多新手学嵌入式最容易被路线图吓到\n\n16\n00:00:32,940 --> 00:00:34,870\n但真实情况不是这样\n\n17\n00:00:34,870 --> 00:00:37,090\n嵌入式不是一条直线学到底\n\n18\n00:00:37,090 --> 00:00:39,050\n而是先学一段公共基础\n\n19\n00:00:39,050 --> 00:00:40,230\n然后分方向\n\n20\n00:00:40,230 --> 00:00:41,070\n第一步\n\n21\n00:00:41,070 --> 00:00:42,940\n公共基础C语言\n\n22\n00:00:42,940 --> 00:00:44,220\n想学好C语言\n\n23\n00:00:44,220 --> 00:00:47,380\n可以去看翁凯或者黑马程序员的基础课程\n\n24\n00:00:47,380 --> 00:00:50,660\n有兴趣可以去刷一下蓝桥或者力扣的题库\n\n25\n00:00:50,660 --> 00:00:51,500\n公共基础\n\n26\n00:00:51,500 --> 00:00:52,120\n第二步\n\n27\n00:00:52,120 --> 00:00:53,260\n单片机入门\n\n28\n00:00:53,260 --> 00:00:55,600\n五一单片机或STM32\n\n29\n00:00:55,600 --> 00:00:57,390\n如果你是完全零基础\n\n30\n00:00:57,390 --> 00:00:59,170\n可以先学五妖单片机\n\n31\n00:00:59,170 --> 00:01:01,550\n巫妖的意义不是他现在多先进\n\n32\n00:01:01,550 --> 00:01:04,550\n而是它能帮你理解GPRIO定时器\n\n33\n00:01:04,550 --> 00:01:07,569\n中断串口时钟这些底层概念\n\n34\n00:01:07,569 --> 00:01:10,529\n这个阶段可以看江协科技的五一单片机\n\n35\n00:01:10,529 --> 00:01:12,050\n跟着敲一遍就行\n\n36\n00:01:12,050 --> 00:01:14,370\n不用在五一单片机上停太久\n\n37\n00:01:14,370 --> 00:01:18,930\n你要达到的标准是能自己写按键控制led定时器\n\n38\n00:01:18,930 --> 00:01:20,819\n闪灯串口收发数据\n\n39\n00:01:20,819 --> 00:01:23,139\n如果你已经有一点编程基础\n\n40\n00:01:23,139 --> 00:01:25,400\n也可以直接上STM32\n\n41\n00:01:25,400 --> 00:01:27,000\n先把项目跑起来\n\n42\n00:01:27,000 --> 00:01:31,460\nSSTM32入门标准库就看江协科技HAL库\n\n43\n00:01:31,460 --> 00:01:32,620\n就看正点原子\n\n44\n00:01:32,620 --> 00:01:35,150\n也可以用铁头山羊的内容做补充\n\n45\n00:01:35,150 --> 00:01:35,990\n公共基础\n\n46\n00:01:35,990 --> 00:01:36,630\n第三步\n\n47\n00:01:36,630 --> 00:01:40,010\n外设和模块项目STM32入门之后\n\n48\n00:01:40,010 --> 00:01:42,210\n重点不是继续疯狂收藏课\n\n49\n00:01:42,210 --> 00:01:44,060\n而是把常用外设跑通\n\n50\n00:01:44,060 --> 00:01:49,550\nGPIO串口定时器PWMADCIICSPI\n\n51\n00:01:49,550 --> 00:01:52,210\n这些是MCU开发里最常见的东西\n\n52\n00:01:52,210 --> 00:01:55,110\n每学一个外设就接一个真实模块\n\n53\n00:01:55,110 --> 00:01:58,350\n学IIC可以接OLED或传感器\n\n54\n00:01:58,350 --> 00:02:00,710\n学串口可以做串口通信\n\n55\n00:02:00,710 --> 00:02:03,310\n学PWM可以控制舵机\n\n56\n00:02:03,310 --> 00:02:04,910\n电机或者呼吸灯\n\n57\n00:02:04,910 --> 00:02:08,550\n学ADC可以采集电压或者传感器数据\n\n58\n00:02:08,550 --> 00:02:09,410\n到这一步\n\n59\n00:02:09,410 --> 00:02:10,930\n你要从我看过课程\n\n60\n00:02:10,930 --> 00:02:12,830\n变成我能做一个小功能\n\n61\n00:02:12,830 --> 00:02:14,590\n然后去做一些小项目\n\n62\n00:02:14,590 --> 00:02:17,030\n比如这个开源的智能小狗捉宠\n\n63\n00:02:17,030 --> 00:02:20,460\n就适合去复刻做自己的第一个完整项目\n\n64\n00:02:20,460 --> 00:02:21,340\n公共基础\n\n65\n00:02:21,340 --> 00:02:21,960\n第四步\n\n66\n00:02:21,960 --> 00:02:24,120\n提前补一点电路和PCB\n\n67\n00:02:24,120 --> 00:02:26,490\n这里我要特别说一下PCB\n\n68\n00:02:26,490 --> 00:02:30,050\n很多人会觉得PCB是硬件工程师才学的\n\n69\n00:02:30,050 --> 00:02:31,630\n嵌入式软件不用管\n\n70\n00:02:31,630 --> 00:02:35,430\n但我觉得就算你以后想做嵌入式软件工程师\n\n71\n00:02:35,430 --> 00:02:38,770\n也最好提前学一点基础电路和简单PCB\n\n72\n00:02:38,770 --> 00:02:41,590\n这一阶段的目标不是成为硬件工程师\n\n73\n00:02:41,590 --> 00:02:43,420\n而是让你能看懂硬件\n\n74\n00:02:43,420 --> 00:02:45,480\n不至于一碰电路就完全懵\n\n75\n00:02:45,480 --> 00:02:49,190\n大家学画PCB可以看expert电子实验室的教学\n\n76\n00:02:49,190 --> 00:02:50,750\n或者去看翻译的视频\n\n77\n00:02:50,750 --> 00:02:51,590\n学习a AD\n\n78\n00:02:51,590 --> 00:02:53,990\n学到这里就可以开始分方向了\n\n79\n00:02:53,990 --> 00:02:55,670\n大致可以分成三类\n\n80\n00:02:55,670 --> 00:02:59,070\nMCU方向学习裸机和RTOS开发\n\n81\n00:02:59,070 --> 00:03:01,910\n这个方向就业去向一般为消费电子\n\n82\n00:03:01,910 --> 00:03:02,930\n工业控制\n\n83\n00:03:02,930 --> 00:03:04,170\n物联网设备\n\n84\n00:03:04,170 --> 00:03:06,430\n可以看为东山的fr TOS\n\n85\n00:03:06,430 --> 00:03:07,890\n正点原子的也行\n\n86\n00:03:07,890 --> 00:03:09,370\n然后想学物联网的\n\n87\n00:03:09,370 --> 00:03:10,730\n学一下MQTT\n\n88\n00:03:10,730 --> 00:03:12,500\n接下来是LINUX方向\n\n89\n00:03:12,500 --> 00:03:14,660\n这个方向更偏系统和软件\n\n90\n00:03:14,660 --> 00:03:16,280\n主要去往智能硬件\n\n91\n00:03:16,280 --> 00:03:18,080\n网关边缘设备\n\n92\n00:03:18,080 --> 00:03:20,850\n车载安防机器人这些岗位\n\n93\n00:03:20,850 --> 00:03:23,070\n不过这个方向需要一定学历\n\n94\n00:03:23,070 --> 00:03:24,110\n岗位相对少\n\n95\n00:03:24,110 --> 00:03:25,320\n但是薪资更高\n\n96\n00:03:25,320 --> 00:03:27,730\n学习同样可以看韦东山的视频\n\n97\n00:03:27,730 --> 00:03:29,430\n最后就是硬件方向\n\n98\n00:03:29,430 --> 00:03:32,090\n这条路就不只是绘画简单PCB\n\n99\n00:03:32,090 --> 00:03:34,010\n而是要继续学模拟电路\n\n100\n00:03:34,010 --> 00:03:35,030\n数字电路\n\n101\n00:03:35,030 --> 00:03:36,970\n电源信号完整性\n\n102\n00:03:36,970 --> 00:03:37,990\n器件选型\n\n103\n00:03:37,990 --> 00:03:39,450\nEMC这些内容\n\n104\n00:03:39,450 --> 00:03:40,170\n学硬件\n\n105\n00:03:40,170 --> 00:03:43,590\n可以多去佳丽创开源广场学习其他大佬的设计\n\n106\n00:03:43,590 --> 00:03:45,390\n最后我想说的是\n\n107\n00:03:45,390 --> 00:03:47,910\n嵌入式的学习是一个漫长的过程\n\n108\n00:03:47,910 --> 00:03:49,690\n他拼的不是一时的速度\n\n109\n00:03:49,690 --> 00:03:51,620\n而是持续的落地与深耕\n\n110\n00:03:51,620 --> 00:03:52,780\n先打好基础\n\n111\n00:03:52,780 --> 00:03:53,980\n再选准方向\n\n112\n00:03:53,980 --> 00:03:54,700\n少囤课\n\n113\n00:03:54,700 --> 00:03:55,360\n多动手\n\n114\n00:03:55,360 --> 00:03:56,980\n要在项目中去学习\n\n115\n00:03:56,980 --> 00:04:00,220\n最后祝大家将来能够找到令自己满意的工作\n\n"}]}, "webpage_url": "https://www.bilibili.com/video/BV1zu5e6NE9y/", "webpage_url_basename": "BV1zu5e6NE9y", "webpage_url_domain": "bilibili.com", "extractor": "BiliBili", "extractor_key": "BiliBili", "thumbnails": [{"url": "http://i1.hdslb.com/bfs/archive/8aa5822f0c4b98a8528c084a7adf6cf88de3c1fb.jpg", "id": "0"}], "display_id": "BV1zu5e6NE9y", "fulltitle": "嵌入式三大学习路线", "duration_string": "4:00", "upload_date": "20260515", "epoch": 1789980231, "format": "720P 准高清+30280 - audio only", "format_id": "30064+30280", "ext": "mp4", "protocol": "https+https", "filesize_approx": 17851277, "tbr": 594.463, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 30.0, "dynamic_range": "SDR", "vcodec": "avc1.640033", "vbr": 465.176, "aspect_ratio": 1.78, "acodec": "mp4a.40.2", "abr": 129.287, "_type": "video", "_version": {"version": "2026.08.30.232658", "release_git_head": "bbc809a1161d3bfca51fa36f59dda35556ee85a0", "repository": "yt-dlp/yt-dlp-nightly-builds"}}