id=d3ed41ee6992aa5000a27c986ab0ef12&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1150, "height": 720, "vcodec": "av01.0.08M.08.0.110.01.01.01.0", "acodec": "none", "dynamic_range": "SDR", "tbr": 151.032, "quality": 64, "format_id": "100024", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 151.032, "resolution": "1150x720", "aspect_ratio": 1.6, "filesize_approx": 18429679, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1YiTb6dEED/"}}, {"url": "https://upos-sz-mirrorcos.bilivideo.com/upgcxcode/93/64/39625756493/39625756493-1-30064.m4s?e=ig8euxZM2rNcNbdlhoNvNC8BqJIzNbfqXBvEqxTEto8BTrNvN0GvT90W5JZMkX_YN0MvXg8gNEV4NC8xNEV4N03eN0B5tZlqNxTEto8BTrNvNeZVuJ10Kj_g2UB02J0mN0B5tZlqNCNEto8BTrNvNC7MTX502C8f2jmMQJ6mqF2fka1mqx6gqj0eN0B599M=&uipk=5&mid=3461562375342187&deadline=1789987634&nbs=1&os=cosbv&og=cos&trid=e2d6c75fa8794b75bb734f80faab4a7u&oi=664447097&gen=playurlv3&platform=pc&upsig=e718f18f0a1c69418da8b64c2751d32f&uparams=e,uipk,mid,deadline,nbs,os,og,trid,oi,gen,platform&bvc=vod&nettype=0&bw=188388&lrs=-1&f=u_0_0&qn_dyeid=d3ed41ee6992aa5000a27c986ab0ef12&agrr=1&buvid=E8010D3A-ED79-58C9-1608-9BD0630C03B175654infoc&build=0&dl=0&orderid=0,3", "ext": "mp4", "fps": 30.0, "width": 1150, "height": 720, "vcodec": "avc1.640033", "acodec": "none", "dynamic_range": "SDR", "tbr": 188.33, "quality": 64, "format_id": "30064", "format": "720P 准高清", "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 188.33, "resolution": "1150x720", "aspect_ratio": 1.6, "filesize_approx": 22980968, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.bilibili.com/video/BV1YiTb6dEED/"}}], "duration": 976.2, "subtitles": {"danmaku": [{"ext": "xml", "url": "https://comment.bilibili.com/39625756493.xml"}], "ai-zh": [{"ext": "srt", "data": "1\n00:00:01,700 --> 00:00:04,980\n然后接下来这个视频简单的讲一下\n\n2\n00:00:04,980 --> 00:00:07,220\n初程序的一些配置\n\n3\n00:00:07,220 --> 00:00:09,170\n初始化的一些配置些简单\n\n4\n00:00:09,170 --> 00:00:12,710\n然后下一个视频我会详细讲一下程序的逻辑\n\n5\n00:00:12,710 --> 00:00:16,030\n而且现在先讲一下配置嗯\n\n6\n00:00:16,030 --> 00:00:17,050\n比如说这个配置\n\n7\n00:00:17,050 --> 00:00:20,350\n然后用的采集三相电流的时候\n\n8\n00:00:20,350 --> 00:00:23,510\n用的是ABC的注入模式\n\n9\n00:00:23,510 --> 00:00:26,590\n注入模式就是三项同时采集\n\n10\n00:00:27,680 --> 00:00:28,960\n那一瞬间同时采集\n\n11\n00:00:28,960 --> 00:00:30,780\n这样的话电流是同一瞬间的\n\n12\n00:00:30,780 --> 00:00:32,920\n这样的话更准确\n\n13\n00:00:32,920 --> 00:00:35,520\n如果不是同一瞬间采集的三相电流\n\n14\n00:00:35,520 --> 00:00:38,580\n这样的话是没有什么意义的\n\n15\n00:00:38,580 --> 00:00:39,680\n所以必须得一瞬间\n\n16\n00:00:39,680 --> 00:00:42,780\n然后紧接着比如说检测温度\n\n17\n00:00:43,180 --> 00:00:45,740\n这些就不需要注入了\n\n18\n00:00:45,740 --> 00:00:49,700\n就需要就只需要普通的u u d ma采集就OK了\n\n19\n00:00:50,310 --> 00:00:52,990\n然后呢还有用到了定时器一和定时器三\n\n20\n00:00:52,990 --> 00:00:58,049\n定时器一的话讲的用主要是用于那个什么嗯\n\n21\n00:00:58,049 --> 00:01:01,349\nPWM生成定时器三的话\n\n22\n00:01:01,349 --> 00:01:03,729\n主要是用来检测或者传感器\n\n23\n00:01:03,729 --> 00:01:06,589\n以及检测那个什么转速的\n\n24\n00:01:09,140 --> 00:01:10,820\n然后可以看一下\n\n25\n00:01:10,820 --> 00:01:12,740\n然后讲一下\n\n26\n00:01:12,740 --> 00:01:14,720\n比如说先看一下ADC的部分\n\n27\n00:01:14,720 --> 00:01:17,100\n初始化相关的配置部分\n\n28\n00:01:20,340 --> 00:01:22,040\n因为我用的是注入模式\n\n29\n00:01:22,040 --> 00:01:24,509\n所以在注弄个注入中断\n\n30\n00:01:24,509 --> 00:01:26,809\n当注入就是ADC采集完后\n\n31\n00:01:26,809 --> 00:01:28,820\n会直接进入到这个函函数\n\n32\n00:01:28,820 